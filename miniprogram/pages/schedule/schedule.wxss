.detail-ico{ position:relative; width:30rpx; height:30rpx; background:transparent; color:#008946; display:flex; align-items:center; justify-content:center; flex-shrink:0; box-sizing:border-box }
.detail-ico text{ font-size:0 }
.detail-date-ico{ border:3rpx solid currentColor; border-radius:6rpx; color:#008946 }
.detail-date-ico::before{ content:''; position:absolute; left:6rpx; top:-8rpx; width:4rpx; height:12rpx; border-radius:4rpx; background:currentColor; box-shadow:12rpx 0 0 currentColor }
.detail-date-ico::after{ content:''; position:absolute; left:4rpx; right:4rpx; top:8rpx; height:4rpx; border-radius:4rpx; background:currentColor }
.detail-lesson-ico{ border:3rpx solid #008946; border-radius:5rpx }
.detail-lesson-ico::before{ content:''; position:absolute; left:7rpx; top:7rpx; width:12rpx; height:3rpx; border-radius:3rpx; background:#008946; box-shadow:0 7rpx 0 #008946,0 14rpx 0 #008946 }
.detail-lesson-ico::after{ content:''; position:absolute; left:3rpx; top:7rpx; width:3rpx; height:3rpx; border-radius:50%; background:#008946; box-shadow:0 7rpx 0 #008946,0 14rpx 0 #008946 }
.detail-minus-ico{ border:3rpx solid #ff4a4f; border-radius:50% }
.detail-minus-ico::before{ content:''; position:absolute; left:7rpx; right:7rpx; top:13rpx; height:3rpx; border-radius:3rpx; background:#ff4a4f }
.detail-num{ color:#11191c; font-weight:800; margin-left:6rpx; margin-right:-6rpx }
