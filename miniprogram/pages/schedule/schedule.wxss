.note-ico{ width:32rpx; height:32rpx; border:3rpx solid #008946; border-radius:5rpx }
.note-ico::before{ content:''; position:absolute; left:7rpx; right:6rpx; top:8rpx; height:3rpx; border-radius:3rpx; background:#008946; box-shadow:0 8rpx 0 #008946 }
.note-ico::after{ content:''; position:absolute; right:-1rpx; top:-1rpx; width:10rpx; height:10rpx; border-left:3rpx solid #008946; border-bottom:3rpx solid #008946; background:#fff; box-sizing:border-box }
.detail-actions{ flex-shrink:0; padding:18rpx 26rpx 64rpx; background:#fff; box-sizing:border-box }
