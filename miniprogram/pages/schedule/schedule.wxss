.spg{ height:100vh; min-height:100vh; overflow:hidden; background:#f5f9fb; display:flex; flex-direction:column; color:#11191c; box-sizing:border-box }
.nav{ position:relative; background:#fff; flex-shrink:0; box-shadow:0 6rpx 20rpx rgba(30,54,64,.035); z-index:2 }
.nav-row{ height:88rpx; display:flex; align-items:center; position:relative }
.nav-back,.nav-safe{ width:116rpx; height:88rpx; flex-shrink:0 }
.nav-back{ display:flex; align-items:center; justify-content:center; z-index:3 }
.nav-back text{ font-size:68rpx; line-height:1; color:#11191c; font-weight:300; margin-top:-7rpx }
.nav-title-wrap{ flex:1; min-width:0; height:88rpx; display:flex; align-items:center; justify-content:center }
.nav-title{ display:block; font-size:40rpx; font-weight:800; color:#11191c; text-align:center; line-height:88rpx; white-space:nowrap }

.calendar-panel{ margin:16rpx 24rpx 18rpx; padding:24rpx 22rpx 26rpx; background:#fff; border-radius:28rpx; box-shadow:0 18rpx 44rpx rgba(25,54,64,.07); flex-shrink:0; overflow:hidden; transition:box-shadow 420ms cubic-bezier(.2,0,0,1), border-radius 420ms cubic-bezier(.2,0,0,1) }
.calendar-collapsed{ box-shadow:0 12rpx 34rpx rgba(25,54,64,.06) }
.month-head{ height:74rpx; display:flex; align-items:center; justify-content:space-between; margin-bottom:12rpx; padding:0 8rpx; box-sizing:border-box }
.mh-btn{ width:54rpx; height:54rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#fff; color:#11191c; border:2rpx solid #e7edf0; box-shadow:0 4rpx 12rpx rgba(20,40,50,.03); flex-shrink:0; box-sizing:border-box }
.mh-btn text{ font-size:45rpx; line-height:1; font-weight:300; margin-top:-5rpx }
.month-title{ height:66rpx; min-width:300rpx; display:flex; align-items:center; justify-content:center; gap:10rpx; border-radius:36rpx; background:#fff; color:#11191c }
.month-title text{ font-size:36rpx; font-weight:900; letter-spacing:0 }
.month-arrow{ width:12rpx; height:12rpx; border-right:3rpx solid #11191c; border-bottom:3rpx solid #11191c; transform:rotate(45deg) translateY(-4rpx); margin-left:2rpx; box-sizing:border-box; flex-shrink:0 }
.week-row{ display:flex; height:52rpx; align-items:center; margin-bottom:4rpx }
.week-row text{ width:14.285%; text-align:center; font-size:25rpx; font-weight:700; color:#8f969b }
.date-stage{ position:relative; height:588rpx; overflow:hidden; transition:height 420ms cubic-bezier(.2,0,0,1) }
.calendar-collapsed .date-stage{ height:70rpx }
.day-grid{ display:flex; flex-wrap:wrap }
.month-grid,.week-grid{ position:absolute; top:0; left:0; right:0; transition:opacity 420ms cubic-bezier(.2,0,0,1), transform 420ms cubic-bezier(.2,0,0,1); transform-origin:top center }
.calendar-swiper{ width:100%; display:block }
.month-swiper{ height:588rpx }
.week-swiper{ height:98rpx; transition:height 420ms cubic-bezier(.2,0,0,1) }
.calendar-collapsed .week-swiper{ height:70rpx }
.month-grid{ opacity:1; transform:translateY(0) scale(1); pointer-events:auto }
.week-grid{ opacity:0; transform:translateY(16rpx) scale(.985); pointer-events:none }
.calendar-collapsed .month-grid{ opacity:0; transform:translateY(-18rpx) scale(.985); pointer-events:none }
.calendar-collapsed .week-grid{ opacity:1; transform:translateY(0) scale(1); pointer-events:auto }
.day-cell{ width:14.285%; height:98rpx; box-sizing:border-box; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; padding-top:8rpx; border-radius:22rpx; position:relative; transition:height 420ms cubic-bezier(.2,0,0,1), padding-top 420ms cubic-bezier(.2,0,0,1), border-radius 420ms cubic-bezier(.2,0,0,1), background-color 220ms ease-out }
.day-cell:active{ background:#e6f6ee }
.day-num{ font-size:29rpx; line-height:34rpx; color:#11191c; font-weight:700; transition:font-size 420ms cubic-bezier(.2,0,0,1), line-height 420ms cubic-bezier(.2,0,0,1), color 220ms ease-out }
.day-out .day-num{ color:#c3cbcf; font-weight:600 }
.day-today{ background:#e6f6ee }
.day-today .day-num{ color:#008946; font-size:32rpx; font-weight:900 }
.day-selected{ background:#eaf2f4 }
.day-selected .day-num{ color:#11191c; font-size:32rpx; font-weight:900 }
.day-marks{ margin-top:7rpx; height:30rpx; display:flex; align-items:center; justify-content:center; gap:0; max-width:102rpx; overflow:hidden; transition:height 420ms cubic-bezier(.2,0,0,1), margin-top 420ms cubic-bezier(.2,0,0,1) }
.day-mark{ min-width:32rpx; height:28rpx; border-radius:28rpx; display:flex; align-items:center; justify-content:center; padding:0 9rpx; box-sizing:border-box; border:1rpx solid rgba(0,0,0,.035); transition:min-width 420ms cubic-bezier(.2,0,0,1), height 420ms cubic-bezier(.2,0,0,1), padding 420ms cubic-bezier(.2,0,0,1) }
.day-mark + .day-mark{ margin-left:6rpx }
.day-mark text{ font-size:20rpx; line-height:28rpx; font-weight:800; transition:font-size 420ms cubic-bezier(.2,0,0,1), line-height 420ms cubic-bezier(.2,0,0,1) }
.mark-red{ background:#ffe9e6; color:#d11b20 }
.mark-red text{ color:#d11b20 }
.mark-green{ background:#e6f6ee; color:#008946 }
.mark-green text{ color:#008946 }
.mark-gray{ background:#f0f2f3; color:#343b3f }
.mark-gray text{ color:#343b3f }
.calendar-collapsed .day-cell{ height:70rpx; padding-top:6rpx; border-radius:18rpx }
.calendar-collapsed .day-marks{ height:24rpx; margin-top:4rpx }
.calendar-collapsed .day-mark{ min-width:26rpx; height:22rpx; padding:0 7rpx }
.calendar-collapsed .day-mark text{ font-size:17rpx; line-height:22rpx }

.recent-panel{ flex:1; min-height:0; overflow:hidden; padding:2rpx 32rpx 0; display:flex; flex-direction:column }
.section-head{ display:flex; align-items:flex-end; justify-content:space-between; margin:0 10rpx 18rpx; flex-shrink:0 }
.section-title{ font-size:40rpx; line-height:48rpx; font-weight:900; color:#11191c }
.section-sub{ display:flex; align-items:center; font-size:26rpx; line-height:38rpx; color:#4f5b60; white-space:nowrap }
.section-sub text{ font-size:26rpx; line-height:38rpx }
.section-arrow{ width:10rpx; height:10rpx; margin-left:8rpx; margin-top:-2rpx; border-right:2rpx solid #4f5b60; border-bottom:2rpx solid #4f5b60; box-sizing:border-box; flex-shrink:0; transform-origin:50% 50% }
.section-arrow.arrow-down{ transform:rotate(45deg) }
.section-arrow.arrow-up{ transform:rotate(225deg) }
.section-sub:active{ opacity:.7 }
.recent-scroll{ width:100%; flex:1; min-height:0; height:0; box-sizing:border-box }
.recent-scroll::-webkit-scrollbar,.recent-scroll ::-webkit-scrollbar{ width:0; height:0; display:none; color:transparent }
.recent-scroll-inner{ padding-bottom:0; box-sizing:border-box }
.recent-scroll-bottom{ height:128rpx; padding-top:22rpx; padding-bottom:constant(safe-area-inset-bottom); padding-bottom:env(safe-area-inset-bottom); box-sizing:border-box; display:flex; align-items:flex-start; justify-content:center }
.recent-scroll-bottom text{ font-size:24rpx; line-height:32rpx; color:#9aa6ac }
.empty-recent,.empty-day{ padding:168rpx 0 72rpx; text-align:center; color:#8b969b; font-size:32rpx; line-height:42rpx; font-weight:800 }

.recent-card,.course-card{ position:relative; display:flex; align-items:center; gap:20rpx; padding:22rpx 22rpx 22rpx 24rpx; border-radius:14rpx; background:#fff; margin-bottom:16rpx; border-left:8rpx solid #008946; box-shadow:0 12rpx 30rpx rgba(22,50,60,.075); box-sizing:border-box; overflow:hidden }
.recent-card{ min-height:144rpx; padding-right:22rpx; border-radius:20rpx; border-top:1rpx solid rgba(178,194,201,.55); border-right:1rpx solid rgba(178,194,201,.55); border-bottom:1rpx solid rgba(178,194,201,.55); background:linear-gradient(180deg,#fff 0%,#fff 62%,#fbfdfe 100%); box-shadow:0 2rpx 6rpx rgba(15,35,42,.04),0 14rpx 34rpx rgba(15,35,42,.09),inset 0 1rpx 0 rgba(255,255,255,.95) }
.recent-card::after{ content:''; position:absolute; left:14rpx; right:14rpx; top:1rpx; height:2rpx; border-radius:2rpx; background:rgba(255,255,255,.9); pointer-events:none }
.recent-card:active,.course-card:active,.student-row:active{ transform:scale(.99); opacity:.92 }
.course-red{ border-left-color:#d81920; background:linear-gradient(90deg,#fff1ef 0%,#fff9f8 62%,#fff 100%); border-top:1rpx solid #fde5e2; border-right:1rpx solid #fde5e2; border-bottom:1rpx solid #fde5e2 }
.course-green{ border-left-color:#008946; background:#fff }
.course-darkgreen{ border-left-color:#008946; background:#fff }
.course-gray{ border-left-color:#8f9ba0; background:#f0f4f5 }
.recent-card.course-green,.recent-card.course-darkgreen{ background:linear-gradient(180deg,#fff 0%,#fff 62%,#fbfdfe 100%); border-top-color:rgba(178,194,201,.55); border-right-color:rgba(178,194,201,.55); border-bottom-color:rgba(178,194,201,.55) }
.recent-card.course-gray{ background:linear-gradient(180deg,#f8fbfc 0%,#f0f4f5 100%); border-top-color:rgba(178,194,201,.55); border-right-color:rgba(178,194,201,.55); border-bottom-color:rgba(178,194,201,.55) }
.course-highlight{ border-top-color:#008946 !important; border-right-color:#008946 !important; border-bottom-color:#008946 !important; animation:course-flash 1600ms cubic-bezier(.2,.8,.2,1) both }
@keyframes course-flash{
  0%{ box-shadow:0 2rpx 6rpx rgba(15,35,42,.04),0 14rpx 34rpx rgba(15,35,42,.09),0 0 0 0 rgba(0,137,70,0) }
  18%{ box-shadow:0 2rpx 6rpx rgba(15,35,42,.04),0 14rpx 34rpx rgba(15,35,42,.09),0 0 0 7rpx rgba(0,137,70,.17) }
  52%{ box-shadow:0 2rpx 6rpx rgba(15,35,42,.04),0 14rpx 34rpx rgba(15,35,42,.09),0 0 0 4rpx rgba(0,137,70,.11) }
  100%{ box-shadow:0 2rpx 6rpx rgba(15,35,42,.04),0 14rpx 34rpx rgba(15,35,42,.09),0 0 0 0 rgba(0,137,70,0) }
}
.course-av{ width:100rpx; height:100rpx; border-radius:50%; flex-shrink:0; background:#eef5f7 }
.course-main{ flex:1; min-width:0 }
.recent-card .course-main{ padding-right:0 }
.course-top{ display:flex; align-items:center; gap:14rpx; min-width:0 }
.course-name{ display:block; max-width:260rpx; font-size:32rpx; line-height:40rpx; font-weight:900; color:#11191c; white-space:nowrap; overflow:hidden; text-overflow:ellipsis }
.course-note{ display:block; font-size:25rpx; line-height:34rpx; color:#667176; margin-top:3rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis }
.course-meta-line{ display:flex; align-items:center; gap:22rpx; margin-top:12rpx; min-width:0; overflow:hidden }
.recent-card .course-meta-line{ margin-top:10rpx }
.course-meta{ display:flex; align-items:center; gap:8rpx; color:#5c676b; font-size:24rpx; line-height:32rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; flex-shrink:0 }
.course-amount{ color:#3e494f; font-size:24rpx; line-height:32rpx; white-space:nowrap; flex-shrink:0 }
.recent-side{ width:112rpx; display:flex; align-items:center; justify-content:flex-end; flex-shrink:0; min-width:0 }
.meta-ico{ width:28rpx; height:28rpx; background:transparent; color:#667176; display:flex; align-items:center; justify-content:center; flex-shrink:0; position:relative; box-sizing:border-box }
.meta-ico text{ font-size:0 }
.meta-date{ border:3rpx solid currentColor; border-radius:6rpx; color:inherit }
.meta-date::before{ content:''; position:absolute; left:5rpx; top:-7rpx; width:4rpx; height:11rpx; border-radius:4rpx; background:currentColor; box-shadow:11rpx 0 0 currentColor }
.meta-date::after{ content:''; position:absolute; left:3rpx; right:3rpx; top:8rpx; height:4rpx; border-radius:4rpx; background:currentColor }
.mini-badge{ height:36rpx; padding:0 14rpx; border-radius:36rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; box-sizing:border-box }
.mini-badge text{ font-size:21rpx; font-weight:800; white-space:nowrap }
.state-pill{ min-width:126rpx; height:58rpx; padding:0 24rpx; border-radius:58rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; box-sizing:border-box; margin-left:4rpx }
.recent-card .course-name{ font-size:36rpx; line-height:44rpx }
.recent-card .course-note{ font-size:27rpx; line-height:36rpx }
.recent-card .course-meta{ font-size:27rpx; line-height:36rpx }
.recent-card .mini-badge{ height:38rpx; padding:0 15rpx; border-radius:38rpx }
.recent-card .mini-badge text{ font-size:23rpx }
.recent-card .state-pill{ min-width:112rpx; height:52rpx; padding:0 20rpx; border-radius:52rpx; margin-left:0; margin-right:0 }
.state-pill text{ font-size:30rpx; font-weight:900; white-space:nowrap }
.recent-card .state-pill text{ font-size:30rpx }
.pill-red{ background:#d81920; color:#fff; box-shadow:0 8rpx 18rpx rgba(216,25,32,.14) }
.mini-red{ background:#fde6e4; color:#d11b20 }
.mini-extra{ background:#fff1ef; color:#d11b20; border:1rpx solid rgba(209,27,32,.12) }
.mini-early{ background:#e6f6ee; color:#008946; border:1rpx solid rgba(0,137,70,.12) }
.pill-green,.pill-darkgreen{ background:#008946; color:#fff; box-shadow:0 8rpx 18rpx rgba(0,137,70,.14) }
.mini-green,.mini-darkgreen{ background:#e6f6ee; color:#008946 }
.pill-gray,.mini-gray{ background:#dde4e6; color:#5c676b }
.course-arrow{ position:absolute; right:22rpx; top:28rpx; font-size:44rpx; color:#aeb8bd; line-height:1; font-weight:300 }
.course-side{ display:flex; flex-direction:column; align-items:flex-end; gap:7rpx; flex-shrink:0 }
.overdue-days{ font-size:21rpx; color:#b4271d; font-weight:700; white-space:nowrap }

.sheet-mask{ position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(22,29,31,.44); z-index:100; display:flex; align-items:flex-end; justify-content:center; transition:opacity 250ms ease }
.sheet{ width:100%; height:75vh; background:#fff; border-radius:36rpx 36rpx 0 0; overflow:hidden; display:flex; flex-direction:column; box-shadow:0 -24rpx 72rpx rgba(0,0,0,.14); will-change:transform }
.sheet-handle{ width:86rpx; height:9rpx; border-radius:9rpx; background:#d9e1e4; margin:16rpx auto 6rpx; flex-shrink:0 }
.sheet-head{ min-height:94rpx; display:flex; align-items:center; justify-content:space-between; padding:0 24rpx; border-bottom:2rpx solid #eef2f4; flex-shrink:0; box-sizing:border-box }
.sheet-back{ width:96rpx; height:80rpx; display:flex; align-items:center; justify-content:flex-start; flex-shrink:0 }
.sheet-back-hidden{ visibility:hidden; pointer-events:none }
.sheet-back text{ font-size:62rpx; color:#161d1f; line-height:1; margin-top:-4rpx }
.sheet-title-wrap{ flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; justify-content:center }
.sheet-title{ max-width:430rpx; text-align:center; font-size:34rpx; line-height:42rpx; font-weight:800; color:#161d1f; white-space:nowrap; overflow:hidden; text-overflow:ellipsis }
.sheet-subtitle{ font-size:22rpx; line-height:30rpx; color:#8b969b; margin-top:2rpx }
.sheet-action{ width:96rpx; height:58rpx; border-radius:58rpx; background:#008946; color:#fff; display:flex; align-items:center; justify-content:center; font-size:26rpx; font-weight:800; flex-shrink:0 }
.sheet-action.ghost{ background:transparent }
.sheet-edit .sheet-action{ background:transparent; color:#008946; font-size:30rpx; font-weight:900; box-shadow:none }
.sheet-body{ flex:1; min-height:0; padding:24rpx 28rpx 0; box-sizing:border-box }
.sheet-body::-webkit-scrollbar,.sheet-body ::-webkit-scrollbar{ width:0; height:0; display:none; color:transparent }
.sheet-day-inner{ min-height:100%; box-sizing:border-box }
.sheet-scroll-bottom{ height:88rpx; padding-bottom:constant(safe-area-inset-bottom); padding-bottom:env(safe-area-inset-bottom); box-sizing:border-box; display:flex; align-items:center; justify-content:center }
.sheet-scroll-bottom text{ font-size:24rpx; line-height:32rpx; color:#9aa6ac }
.sheet-section{ margin-bottom:28rpx }
.sheet-sec-head{ display:flex; align-items:center; gap:12rpx; margin-bottom:16rpx }
.sheet-sec-title{ display:block; font-size:34rpx; line-height:42rpx; font-weight:900; color:#11191c }
.red-text{ color:#b4271d }
.sec-count{ min-width:42rpx; height:36rpx; padding:0 12rpx; border-radius:36rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box }
.sec-count text{ font-size:23rpx; font-weight:900 }
.sec-red{ background:#fde2df; color:#b4271d }
.sec-green{ background:#e6f6ee; color:#008946 }
.day-total-count{ min-width:52rpx; height:44rpx; padding:0 16rpx; border-radius:44rpx }
.day-total-count text{ font-size:29rpx; line-height:44rpx }
.sheet-more{ display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2rpx; color:#8b969b; font-size:24rpx; padding:8rpx 0 32rpx }

.student-search{ position:relative; padding:12rpx 32rpx 12rpx; flex-shrink:0 }
.student-search input{ height:88rpx; background:#f0f3f4; border-radius:46rpx; padding:0 32rpx 0 90rpx; box-sizing:border-box; font-size:30rpx; color:#161d1f }
.search-mark{ position:absolute; left:66rpx; top:40rpx; width:32rpx; height:32rpx; border:5rpx solid #6d777c; border-radius:50%; box-sizing:border-box; z-index:1 }
.search-mark::after{ content:''; position:absolute; width:17rpx; height:5rpx; background:#6d777c; border-radius:5rpx; transform:rotate(45deg); right:-13rpx; bottom:-8rpx }
.student-body{ padding:0 32rpx; box-sizing:border-box }
.student-inner{ min-height:100%; box-sizing:border-box }
.student-scroll-bottom{ height:88rpx; padding-bottom:constant(safe-area-inset-bottom); padding-bottom:env(safe-area-inset-bottom); box-sizing:border-box; display:flex; align-items:center; justify-content:center }
.student-scroll-bottom text{ font-size:24rpx; line-height:32rpx; color:#9aa6ac }
.student-row{ position:relative; display:flex; align-items:center; gap:24rpx; min-height:124rpx; padding:22rpx 20rpx 22rpx 26rpx; border-radius:18rpx; background:linear-gradient(180deg,#fff 0%,#fff 62%,#fbfdfe 100%); border:1rpx solid rgba(178,194,201,.55); margin-bottom:16rpx; box-shadow:0 2rpx 6rpx rgba(15,35,42,.04),0 14rpx 34rpx rgba(15,35,42,.08),inset 0 1rpx 0 rgba(255,255,255,.95); box-sizing:border-box; overflow:hidden }
.student-row::after{ content:''; position:absolute; left:14rpx; right:14rpx; top:1rpx; height:2rpx; border-radius:2rpx; background:rgba(255,255,255,.9); pointer-events:none }
.student-disabled{ opacity:.7 }
.student-av{ width:100rpx; height:100rpx; border-radius:50%; flex-shrink:0; background:#eef5f7 }
.student-info{ flex:1; min-width:0 }
.student-name{ display:block; font-size:34rpx; line-height:42rpx; font-weight:900; color:#161d1f; white-space:nowrap; overflow:hidden; text-overflow:ellipsis }
.student-sub{ display:block; font-size:27rpx; line-height:34rpx; color:#5f696e; margin-top:6rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis }
.student-right{ display:flex; flex-direction:column; align-items:flex-end; flex-shrink:0; min-width:132rpx }
.student-remain{ font-size:34rpx; font-weight:900; color:#008946; line-height:40rpx }
.student-remain-red{ color:#b4271d }
.student-remain-gray{ color:#7f8b90 }
.student-status{ height:40rpx; padding:0 18rpx; border-radius:40rpx; display:flex; align-items:center; justify-content:center; margin-top:10rpx; box-sizing:border-box }
.student-status text{ font-size:23rpx; font-weight:800; white-space:nowrap }
.student-status-green{ background:#e6f6ee; color:#008946 }
.student-status-red{ background:#fde2df; color:#b4271d }
.student-status-gray{ background:#dde4e6; color:#5c676b }
.student-status-text{ margin-top:10rpx; font-size:25rpx; line-height:34rpx; color:#5f696e; white-space:nowrap }
.student-arrow{ color:#aab3b8; font-size:48rpx; line-height:1; margin-left:4rpx; margin-right:-2rpx; flex-shrink:0; font-weight:300 }
.student-tip{ margin:12rpx 32rpx 28rpx; min-height:70rpx; padding:0 22rpx; border-radius:20rpx; background:#f2f8f5; color:#3d4a3e; font-size:26rpx; line-height:34rpx; display:flex; align-items:center; justify-content:center; gap:14rpx; flex-shrink:0; box-sizing:border-box }
.student-tip-ico{ width:32rpx; height:32rpx; border-radius:50%; border:4rpx solid #008946; color:#008946; display:flex; align-items:center; justify-content:center; font-size:22rpx; line-height:1; font-weight:900; box-sizing:border-box; flex-shrink:0 }
.student-tip text{ color:#3d4a3e; font-size:26rpx; line-height:34rpx; white-space:nowrap }

.form-body{ padding:22rpx 44rpx 10rpx; box-sizing:border-box }
.form-student-head{ display:flex; flex-direction:column; align-items:center; justify-content:center; padding:0 0 12rpx; box-sizing:border-box }
