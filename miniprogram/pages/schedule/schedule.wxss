.detail-note{ margin-top:20rpx; padding:26rpx 28rpx 24rpx; border-radius:18rpx; background:#fff; border:2rpx solid #edf2f4; box-shadow:0 8rpx 20rpx rgba(16,48,38,.03); color:#5c676b; font-size:28rpx; line-height:1.55; box-sizing:border-box }
.note-title-row{ display:flex; align-items:center; gap:16rpx; margin-bottom:16rpx }
.note-title{ display:block; font-size:29rpx; line-height:38rpx; color:#161d1f; font-weight:900 }
