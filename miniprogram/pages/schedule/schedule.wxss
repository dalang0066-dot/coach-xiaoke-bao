.form-field{ margin-bottom:24rpx }
.form-label{ display:block; font-size:27rpx; color:#5c676b; font-weight:800; margin-bottom:14rpx }
.form-input{ height:88rpx; display:flex; align-items:center; padding:0 24rpx; background:#f0f4f5; border-radius:14rpx; box-sizing:border-box; font-size:31rpx; color:#161d1f; font-weight:700 }
.form-readonly{ height:92rpx; padding:0 28rpx; color:#161d1f; background:#f0f4f5; box-shadow:inset 0 1rpx 0 rgba(255,255,255,.75) }
.form-pick{ background:#fff; border:2rpx solid #e1e7e9; box-shadow:0 2rpx 8rpx rgba(15,35,42,.025) }
.form-ico{ position:relative; width:46rpx; height:46rpx; margin-right:24rpx; flex-shrink:0; color:#008946; box-sizing:border-box }
.form-ico text{ font-size:0 }
.form-date-ico{ border:4rpx solid currentColor; border-radius:9rpx; color:#008946 }
.form-date-ico::before{ content:''; position:absolute; left:10rpx; top:-10rpx; width:6rpx; height:15rpx; border-radius:6rpx; background:currentColor; box-shadow:20rpx 0 0 currentColor }
.form-date-ico::after{ content:''; position:absolute; left:6rpx; right:6rpx; top:14rpx; height:5rpx; border-radius:5rpx; background:currentColor }
.form-arrow{ margin-left:auto; color:#aeb8bd; font-size:48rpx; line-height:1; font-weight:300 }
.amount-row{ display:flex; gap:16rpx; align-items:center }
.amount-btn{ flex:1; height:78rpx; border-radius:12rpx; border:2rpx solid #dfe6e8; color:#3d4a3e; display:flex; align-items:center; justify-content:center; font-size:29rpx; font-weight:700; box-sizing:border-box; background:#fff; box-shadow:0 2rpx 8rpx rgba(15,35,42,.025) }
.amount-on{ border:3rpx solid #008946 !important; background:#fff !important; color:#161d1f !important }
.amount-input{ flex:1; width:0; min-width:0; height:78rpx; border-radius:12rpx; border:2rpx solid #dfe6e8; background:#fff; text-align:center; font-size:29rpx; color:#161d1f; box-sizing:border-box; font-weight:700; box-shadow:0 2rpx 8rpx rgba(15,35,42,.025) }
.amount-input-on{ border:3rpx solid #008946 }
.amount-input-shake{ animation: amountShake .32s ease }
.amount-placeholder{ color:#a8b2b7; font-weight:700 }
@keyframes amountShake {
  0%,100%{ transform:translateX(0) }
  20%{ transform:translateX(-8rpx) }
  40%{ transform:translateX(7rpx) }
  60%{ transform:translateX(-5rpx) }
  80%{ transform:translateX(4rpx) }
}
.ta-wrap{ position:relative; background:#f0f4f5; border-radius:14rpx; padding:18rpx 24rpx 38rpx; box-sizing:border-box; box-shadow:inset 0 1rpx 0 rgba(255,255,255,.75) }
.form-ta{ width:100%; max-height:210rpx; font-size:30rpx; line-height:40rpx; color:#161d1f; box-sizing:border-box; margin:0; padding:0; background:transparent; overflow-y:auto }
.ta-count{ position:absolute; right:24rpx; bottom:18rpx; color:#5c676b; font-size:25rpx }
.sheet-foot{ padding:14rpx 44rpx 64rpx; flex-shrink:0; background:#fff }
.primary-btn{ height:92rpx; border-radius:92rpx; background:#008946; color:#fff; display:flex; align-items:center; justify-content:center; font-size:32rpx; font-weight:900; box-shadow:0 16rpx 42rpx rgba(0,137,70,.18) }
.primary-btn:active{ transform:scale(.98); opacity:.9 }

.detail-body{ padding:28rpx 26rpx 24rpx; flex:1; min-height:0; box-sizing:border-box; overflow:hidden }
.detail-card{ position:relative; padding:34rpx 26rpx 30rpx; border-radius:18rpx; background:#fff; border:2rpx solid #edf2f4; box-shadow:0 8rpx 20rpx rgba(16,48,38,.035); box-sizing:border-box }
