<view class="pg" bindtap="onTapBlank">
  <view class="topbar" style="padding-top:{{sbh}}px"><text class="topbar-tt">教练消课宝</text></view>

  <!-- 空状态 -->
  <block wx:if="{{empty}}">
    <scroll-view class="empty-scroll" scroll-y="true">
      <view class="guide-box">
        <swiper class="guide-sw" indicator-dots="true" indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#fff" autoplay="true" circular="true">
          <swiper-item><view class="guide-s1"><view class="guide-txt"><text class="guide-h">简单、高效、专业</text><text class="guide-p">记录每一份成长，管理每一节课堂</text></view></view></swiper-item>
          <swiper-item><view class="guide-s2"><view class="guide-txt"><text class="guide-h">3秒消课，高效管理</text><text class="guide-p">上完课即刻记录，不浪费每一秒</text></view></view></swiper-item>
          <swiper-item><view class="guide-s3"><view class="guide-txt"><text class="guide-h">数据安全，永不丢失</text><text class="guide-p">云端+本地双备份，换设备无忧</text></view></view></swiper-item>
        </swiper>
        <view class="guide-grad"></view>
      </view>
      <view class="empty-act">
        <text class="empty-hint">点击添加你的第一个学员</text>
        <view class="big-btn" bindtap="onAdd"><text class="big-btn-icon">+</text></view>
      </view>
    </scroll-view>
  </block>

  <!-- 学员列表状态 -->
  <block wx:else>
    <view class="banner" wx:if="{{showSleepy}}">
      <view class="banner-l"><text class="banner-ico">!</text><text class="banner-txt">{{sleepyName}}学员超过30天没上课了！</text></view>
      <view class="banner-x" bindtap="dismissSleepy"><text>✕</text></view>
    </view>
    <view class="banner" wx:if="{{showExpiry}}">
      <view class="banner-l"><text class="banner-ico">!</text><text class="banner-txt">学员{{expiryName}}的课时还有{{expiryDay}}天过期</text></view>
      <view class="banner-x" bindtap="dismissExpiry"><text>✕</text></view>
    </view>
    <view class="banner" wx:if="{{showMember}}">
      <view class="banner-l" bindtap="onUpgrade"><text class="banner-ico">!</text><text class="banner-txt">您的会员已到期，点击升级会员</text></view>
      <view class="banner-x" bindtap="dismissMember"><text>✕</text></view>
    </view>

    <scroll-view class="list-scroll" scroll-y="true" scroll-top="{{scrollTop}}" bindscroll="onScroll">
      <view class="list-wrap" bindtap="onTapBlank">
        <block wx:for="{{list}}" wx:key="id">
          <view class="card-box {{item.open ? 'card-open' : ''}} {{item.highlight ? 'card-hl' : ''}}">
            <view class="card-actions">
              <view class="act-btn act-edit" bindtap="onEdit" data-id="{{item.id}}"><text>编辑</text></view>
              <view class="act-btn act-hist" bindtap="onHist" data-id="{{item.id}}"><text>历史</text></view>
              <view class="act-btn act-del" bindtap="onDel" data-id="{{item.id}}"><text>删除</text></view>
            </view>
            <view 
              class="card-main {{item.open ? 'card-swiped' : ''}} {{item.exp ? 'card-gray' : (item.low ? 'card-red' : '')}}"
              data-id="{{item.id}}"
              data-ix="{{index}}"
              bindtouchstart="ts"
              bindtouchend="te"
              catchtap="onCardTap"
            >
              <view class="card-av {{item.exp ? 'av-gray' : ''}}"><text class="av-emoji">{{item.avatarEmoji}}</text></view>
              <view class="card-info">
                <text class="card-name {{item.exp ? 'c-gray' : ''}}">{{item.name}}</text>
                <text class="card-note {{item.exp ? 'c-gray' : ''}}">{{item.note || ''}}</text>
              </view>
              <view class="card-num">
                <text class="num-val {{item.exp ? 'c-gray' : (item.low ? 'c-red' : 'c-green')}}">{{item.exp ? '已过期' : item.remainingLessons}}</text>
                <text class="num-lbl {{item.exp ? 'c-gray' : ''}}">剩余课时</text>
              </view>
            </view>
          </view>
        </block>
        <view class="no-result" wx:if="{{list.length===0 && keyword}}"><text class="c-gray2">未找到匹配的学员</text></view>
        <view class="pad-bot"></view>
      </view>
    </scroll-view>
  </block>

  <!-- 底部栏 -->
  <view class="bot-bar" wx:if="{{!empty}}">
    <view class="search-wrap">
      <view class="search-icon-wrap"><text>🔍</text></view>
      <input class="search-inp" placeholder="搜索学员..." value="{{keyword}}" bindinput="onSearch" bindfocus="onSearchFocus" bindblur="onSearchBlur" adjust-position="{{false}}" cursor-spacing="{{12}}" confirm-type="search"/>
    </view>
    <view class="add-btn2" bindtap="onAddTap"><text class="add-ico">+</text><text>添加学员</text></view>
  </view>

  <!-- ===== 消课确认弹窗 ===== -->
  <view class="modal" wx:if="{{showClass}}" catchtap="closeClass">
    <view class="modal-box modal-class" catchtap="nop">
      <view class="mc-body">
        <view class="mc-circle"><text class="mc-check">✓</text></view>
        <text class="mc-title">消课 1 节？</text>
        <text class="mc-desc">确认后将为学员 <text class="b">{{classTarget.name}}</text> 扣除 1 次课时</text>
      </view>
      <view class="mc-btns">
        <view class="mc-btn mc-cancel" bindtap="closeClass"><text>取消</text></view>
        <view class="mc-btn mc-ok" bindtap="doClass"><text>确认消课</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 添加/编辑学员弹窗 ===== -->
  <view class="modal" wx:if="{{showForm}}" catchtap="closeForm">
    <view class="modal-box modal-form" catchtap="nop">
      <view class="mf-head"><text class="mf-title">{{editing?'编辑学员':'添加学员'}}</text></view>
      <scroll-view class="mf-body" scroll-y="true" enhanced="true" show-scrollbar="false">
        <view class="mf-av" bindtap="randAv">
          <text class="mf-av-emoji">{{fd.avatarEmoji}}</text>
          <view class="mf-av-hint"><text>🔄</text></view>
        </view>
        <view class="mf-f">
          <text class="mf-lbl">姓名</text>
          <input class="mf-inp" placeholder="输入学员姓名" value="{{fd.name}}" bindinput="onFdName" maxlength="20"/>
        </view>
        <view class="mf-f">
          <text class="mf-lbl">课时数</text>
          <input class="mf-inp mf-num" type="number" placeholder="0" value="{{fd.totalLessons}}" bindinput="onFdLessons"/>
        </view>
        <view class="mf-quick">
          <view class="mq-btn {{fd.totalLessons===12?'mq-on':''}}" data-v="12" bindtap="onQuick"><text>12节</text></view>
          <view class="mq-btn {{fd.totalLessons===24?'mq-on':''}}" data-v="24" bindtap="onQuick"><text>24节</text></view>
          <view class="mq-btn {{fd.totalLessons===36?'mq-on':''}}" data-v="36" bindtap="onQuick"><text>36节</text></view>
        </view>
        <view class="mf-f">
          <text class="mf-lbl">有效期至（默认6个月）</text>
          <picker mode="date" value="{{fd.expiryDate}}" bindchange="onFdDate">
            <view class="mf-inp mf-date"><text class="{{fd.expiryDate?'':'mf-ph'}}">{{fd.expiryDate||'请选择日期'}}</text></view>
          </picker>
        </view>
        <view class="mf-f">
          <text class="mf-lbl">备注</text>
          <textarea class="mf-ta" placeholder="例如：腰椎损伤，加强核心" value="{{fd.note}}" bindinput="onFdNote" maxlength="100" auto-height="true"/>
        </view>
        <view class="mf-spacer"></view>
      </scroll-view>
      <view class="mf-foot">
        <view class="mff-btn mff-cancel" bindtap="closeForm"><text>{{editing?'关闭':'取消'}}</text></view>
        <view class="mff-btn mff-ok" bindtap="submitForm"><text>{{editing?'保存':'添加学员'}}</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 删除确认弹窗 ===== -->
  <view class="modal" wx:if="{{showDel}}" catchtap="closeDel">
    <view class="modal-box modal-del" catchtap="nop">
      <view class="md-icon"><text>🗑</text></view>
      <text class="md-title">确定要删除学员吗？</text>
      <text class="md-desc"><text class="b">{{delTarget.name}}</text> 的所有历史记录将无法恢复。</text>
      <view class="md-btns">
        <view class="md-btn md-cancel" bindtap="closeDel"><text>取消</text></view>
        <view class="md-btn md-ok" bindtap="doDel"><text>确定删除</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 课时过期弹窗 ===== -->
  <view class="modal" wx:if="{{showExpModal}}" catchtap="closeExpModal">
    <view class="modal-box modal-exp" catchtap="nop">
      <view class="me-outer"><view class="me-inner"><text class="me-mark">!</text></view></view>
      <text class="me-title">该学员课时已过期</text>
      <text class="me-desc">请先前往编辑页面添加课时</text>
      <view class="me-btn-wrap"><view class="me-btn" bindtap="closeExpModal"><text>确定</text></view></view>
    </view>
  </view>

  <!-- ===== 升级弹窗 ===== -->
  <view class="modal" wx:if="{{showUpg}}" catchtap="closeUpg">
    <view class="modal-box modal-upg" catchtap="nop">
      <view class="mu-head">
        <view class="mu-badge"><text>PRO VERSION</text></view>
        <view class="mu-crown"><text>👑</text></view>
        <text class="mu-htitle">免费版学员已满</text>
      </view>
      <view class="mu-body">
        <text class="mu-desc">升级专业版，享受<text class="c-green b">无限学员</text>管理，开启<text class="c-green b">续费预警</text>与<text class="c-green b">数据永久同步</text>。</text>
        <view class="plan {{plan==='monthly'?'plan-on':''}}" data-plan="monthly" bindtap="onPlan">
          <view class="plan-rd {{plan==='monthly'?'rd-on':''}}"><view wx:if="{{plan==='monthly'}}" class="rd-dot"></view></view>
          <view class="plan-info"><text class="plan-n">月卡 18.8 元 / 月</text><text class="plan-s c-gray2">按月订阅，随时取消</text></view>
        </view>
        <view class="plan {{plan==='yearly'?'plan-on':''}}" data-plan="yearly" bindtap="onPlan">
          <view class="plan-rd {{plan==='yearly'?'rd-on':''}}"><view wx:if="{{plan==='yearly'}}" class="rd-dot"></view></view>
          <view class="plan-info"><text class="plan-n">年卡 128.8 元 / 年</text><text class="plan-s c-green">约 10.7 元 / 月，超值推荐</text></view>
        </view>
        <view class="mu-submit" bindtap="doUpg"><text>立即升级</text></view>
        <view class="mu-later" bindtap="closeUpg"><text>稍后再说</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 历史记录弹窗 ===== -->
  <view class="modal" wx:if="{{showHist}}" catchtap="closeHist">
    <view class="modal-box modal-hist" catchtap="nop">
      <view class="mh-head">
        <text class="mh-title">历史记录</text>
      </view>
      <view class="mh-sum">
        <view class="mhs-av"><text class="mhs-emoji">{{histData.emoji}}</text></view>
        <view class="mhs-info">
          <text class="mhs-name">{{histData.name}}</text>
          <view class="mhs-badge"><text>剩余 {{histData.remaining}} 节</text></view>
        </view>
      </view>
      <scroll-view class="mh-body" scroll-y="true" show-scrollbar="false">
        <text class="mhb-lbl">记录详情</text>
        <block wx:for="{{histData.records}}" wx:for-index="idx" wx:key="idx">
          <view class="hrec {{item.type==='recharge'?'hrec-g':''}}" wx:if="{{item.type !== 'undo'}}">
            <view class="hrec-l">
              <view class="hrec-ico {{item.type==='deduct'?'hri-red':'hri-gr'}}">
                <text>{{item.type==='deduct'?'−':'✓'}}</text>
              </view>
              <view class="hrec-info">
                <text class="hrec-act">{{item.type==='deduct'?'消课':'新增'}} <text class="hrec-num {{item.type==='deduct'?'c-red':'c-green'}}">{{item.amount}}</text> 节</text>
                <text class="hrec-time">{{item.time}}</text>
              </view>
            </view>
          </view>
        </block>
        <view wx:if="{{histData.records.length===0}}" class="hrec-empty"><text>暂无上课记录</text></view>
      </scroll-view>
      <view class="mh-foot">
        <view class="mhf-btn" bindtap="closeHist"><text>确认</text></view>
      </view>
    </view>
  </view>

  <!-- Toast -->
  <view class="toast toast-undo {{showUndo?'toast-on':''}}">
    <view class="toast-left"><text class="toast-gr">✓</text><text class="toast-wt">消课成功</text></view>
    <view class="toast-div"></view><text class="toast-link" catchtap="undoClass">点击撤销</text>
  </view>
  <view class="toast toast-top {{showLowT?'toast-on':''}}"><text class="toast-wt">{{lowMsg}}</text></view>
  <view class="toast toast-bot {{showOkT?'toast-on':''}}">
    <view class="toast-left"><text class="toast-gr">✓</text><text class="toast-wt">操作成功</text></view>
  </view>
</view>