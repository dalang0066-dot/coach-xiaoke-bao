<view class="pg">
  <text class="topbar-tt {{empty ? '' : 'topbar-white'}}" style="padding-top:{{sbh}}px">教练消课宝</text>
  <view class="top-ico" wx:if="{{!empty}}" style="top:{{icoTop}}rpx;left:{{icoLeft}}rpx;width:{{icoSize}}rpx;height:{{icoSize}}rpx;border-radius:{{icoRadius}}rpx" bindtap="onTopIco">
    <image class="top-ico-img" src="/images/feedback-icon.png" mode="aspectFit"></image>
  </view>

  <!-- 空状态 -->
  <block wx:if="{{empty}}">
    <scroll-view class="empty-scroll" scroll-y="true" bindtap="onGuideTap" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" refresher-background="#f6fbfd" bindrefresherrefresh="onRefreshStudents">
      <image class="empty-bg" src="/images/bg.jpg" mode="widthFix"></image>
    </scroll-view>
    <view class="big-btn" catchtap="onAdd">
      <text class="big-btn-text" style="font-size:45rpx">添加学员</text>
      <image class="big-btn-icon" src="/images/add-icon.png" mode="aspectFit"></image>
    </view>
  </block>

  <!-- 学员列表状态 -->
  <block wx:else>
    <view class="banner banner-swipe" wx:if="{{showSwipeBanner}}">
      <view class="banner-l"><text class="banner-txt">左滑学员卡片可以查看排课和历史哦~</text></view>
      <view class="banner-x" bindtap="dismissSwipeHint"><text>×</text></view>
    </view>
    <view class="banner" wx:if="{{showSleepy}}">
      <view class="banner-l"><image class="banner-ico-img" src="/images/banner-icon.png"></image><text class="banner-txt">学员{{sleepyName}}超过30天没上课啦！！！</text></view>
      <view class="banner-x" bindtap="dismissSleepy"><text>×</text></view>
    </view>
    <view class="banner" wx:if="{{showExpiry}}">
      <view class="banner-l"><image class="banner-ico-img" src="/images/banner-icon.png"></image><text class="banner-txt">学员{{expiryName}}的课时还有{{expiryDay}}天过期啦！！！</text></view>
      <view class="banner-x" bindtap="dismissExpiry"><text>×</text></view>
    </view>
    <view class="banner" wx:if="{{showMember}}">
      <view class="banner-l" bindtap="onUpgrade"><image class="banner-ico-img" src="/images/banner-icon.png"></image><text class="banner-txt">您的会员已到期，点击升级会员！！！</text></view>
      <view class="banner-x" bindtap="dismissMember"><text>×</text></view>
    </view>

    <scroll-view class="list-scroll" scroll-y="{{scrollY}}" scroll-top="{{scrollTop}}" bindscroll="onScroll" bindtap="onTapBlank" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" refresher-background="#f6fbfd" bindrefresherrefresh="onRefreshStudents">
      <view class="list-wrap" bindtap="onTapBlank">
        <block wx:for="{{list}}" wx:key="id">
          <view class="card-box {{item.open ? 'card-open' : ''}} {{item.highlight}}">
            <view class="swipe-frame">
              <view class="swipe-actions">
                <view class="act-btn act-edit" catchtap="onEdit" data-id="{{item.id}}"><image class="act-ico" src="/images/swipe-edit.png"></image><view class="act-label"><text>编辑</text><text>学员</text></view></view>
                <view class="act-btn act-schedule" catchtap="onViewSchedules" data-id="{{item.id}}"><view class="act-ico act-schedule-ico"></view><view class="act-label"><text>查看</text><text>排课</text></view></view>
                <view class="act-btn act-hist" catchtap="onHist" data-id="{{item.id}}"><image class="act-ico" src="/images/swipe-history.png"></image><view class="act-label"><text>历史</text><text>记录</text></view></view>
                <view class="act-btn act-del" catchtap="onDel" data-id="{{item.id}}"><image class="act-ico" src="/images/swipe-delete.png"></image><view class="act-label"><text>删除</text><text>学员</text></view></view>
              </view>
              <view
                style="transform:translateX({{item.open ? -552 : (item._sx || 0)}}rpx);transition:{{item._st===false?'none':'transform .35s ease'}}"
                class="card-face {{item.inactive ? 'card-gray' : (item.low ? 'card-low-line' : '')}} card-schedule-{{item.scheduleTone}} {{showHintT && index===0 ? 'card-hint' : ''}}"
                data-id="{{item.id}}"
                data-ix="{{index}}"
                bindtouchstart="ts"
                bindtouchmove="tm"
                bindtouchend="te"
                bindtouchcancel="tc"
                catchtap="onCardTap"
              >
                <view class="card-main">
                  <view class="card-av {{item.inactive ? 'av-gray' : ''}}"><image class="av-img" src="{{item.avatarSrc}}" mode="aspectFill"></image></view>
                  <view class="card-info">
                    <view class="card-name-row">
                      <text class="card-name {{item.inactive ? 'c-gray' : ''}}">{{item.name}}</text>
                      <text wx:if="{{item.scheduleStatusText}}" class="overdue-tag {{item.scheduleStatusTone==='red' ? 'tag-red' : 'tag-green'}}">{{item.scheduleStatusText}}</text>
                    </view>
                    <text class="card-note {{item.inactive ? 'c-gray' : ''}}">{{item.note || ''}}</text>
                  </view>
                  <view class="card-num">
                    <text class="num-val {{item.inactive ? 'c-gray' : (item.low ? 'c-red' : 'c-green')}}">{{item.exp ? '已过期' : item.remainingLessons}}</text>
                    <text class="num-lbl {{item.inactive ? 'c-gray' : (item.low ? 'c-red' : '')}}">剩余课时</text>
                  </view>
                </view>
                <view class="schedule-strip">
                  <view wx:for="{{item.scheduleDisplayChips}}" wx:for-item="chip" wx:key="id" class="schedule-chip schedule-chip-{{chip.tone}}">
                    <view class="chip-ico chip-{{chip.icon}}"></view>
                    <text>{{chip.label}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
          <view class="card-hint-tip" wx:if="{{showHintT && index===0}}"><text>左滑卡片试试~</text></view>
        </block>
        <view class="no-result" wx:if="{{list.length===0 && keyword}}"><text class="c-gray2">未找到匹配的学员</text></view>
        <view class="pad-bot"><text wx:if="{{listHasOverflow}}">没有更多学员啦~</text></view>
      </view>
    </scroll-view>

    <view class="schedule-fab-hit" style="{{scheduleFabStyle}}" bindtap="goSchedule">
      <view class="schedule-fab">
        <text>排课</text>
        <view wx:if="{{scheduleBadge.count}}" class="schedule-fab-badge {{scheduleBadge.tone==='red' ? 'schedule-fab-red' : 'schedule-fab-green'}}">
          <text>{{scheduleBadge.count}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 底部栏 -->
  <view class="bot-bar" wx:if="{{!empty}}" style="padding-bottom:{{botPad}}rpx;bottom:{{kbH}}px">
    <view class="search-wrap">
      <view class="search-icon-wrap"><image class="search-ico-img" src="/images/search-icon.png"></image></view>
      <input class="search-inp" placeholder="搜索学员..." value="{{keyword}}" bindinput="onSearch" bindfocus="onSearchFocus" bindblur="onSearchBlur" adjust-position="{{false}}" cursor-spacing="{{2}}" confirm-type="search"/>
      <view class="search-clear" wx:if="{{keyword}}" catchtap="onSearchClear"><text>×</text></view>
    </view>
    <view class="add-btn2" bindtap="onAddTap">
        <view class="add-plus-wrap"><view class="add-plus-h"></view><view class="add-plus-v"></view></view>
        <text>添加学员</text>
      </view>
  </view>

  <!-- ===== 查看排课弹窗 ===== -->
  <view class="modal modal-overdue" wx:if="{{showStudentSchedules}}" catchtap="closeStudentSchedules">
    <view class="modal-box overdue-box student-schedules-box" catchtap="nop">
      <view class="overdue-head">
        <text class="overdue-title">排课安排</text>
      </view>
      <scroll-view class="overdue-scroll" scroll-y="{{true}}" show-scrollbar="{{false}}">
        <view class="overdue-inner">
          <view wx:if="{{studentScheduleList.length===0}}" class="student-schedules-empty"><text>暂无排课安排~</text></view>
          <view wx:for="{{studentScheduleList}}" wx:key="id" class="overdue-item student-schedule-item student-schedule-{{item.stateTone}}">
            <view data-id="{{item.id}}" catchtap="openStudentScheduleDetail">
            <view class="overdue-card course-{{item.stateTone}}">
              <image class="overdue-av" src="{{item.avatarSrc}}" mode="aspectFill"></image>
              <view class="overdue-main">
                <view class="overdue-top">
                  <text class="overdue-name">{{item.studentName}}</text>
                  <view class="overdue-mini mini-{{item.stateTone}}"><text>{{item.displayAmountText}}节课</text></view>
                </view>
                <text class="overdue-note" wx:if="{{item.note}}">{{item.note}}</text>
                <view class="overdue-meta-line">
                  <view class="overdue-meta"><view class="overdue-meta-ico overdue-meta-date"><text></text></view><text>{{item.dateShort}} {{item.weekday}}</text></view>
                  <view class="overdue-meta"><view class="overdue-meta-ico overdue-meta-time"><text></text></view><text>{{item.startTime}}</text></view>
                </view>
              </view>
              <view class="overdue-side">
                <view class="overdue-pill pill-{{item.stateTone}}"><text>{{item.stateText}}</text></view>
              </view>
            </view>
            </view>
            <view class="overdue-actions overdue-actions-three">
              <view class="overdue-act overdue-act-ok" data-id="{{item.id}}" catchtap="onStudentScheduleDeduct"><text>消课</text></view>
              <view class="overdue-act overdue-act-edit" data-id="{{item.id}}" catchtap="onStudentScheduleReschedule"><text>改期</text></view>
              <view class="overdue-act overdue-act-del" data-id="{{item.id}}" catchtap="onStudentScheduleDelete"><text>删除</text></view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="overdue-foot">
        <view class="overdue-cancel" bindtap="closeStudentSchedules"><text>取消</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 多节未消课弹窗 ===== -->
  <view class="modal modal-overdue" wx:if="{{showMultiOverdue}}" catchtap="closeMultiOverdue">
    <view class="modal-box overdue-box" catchtap="nop">
      <view class="overdue-head">
        <text class="overdue-title">有多节课未消</text>
      </view>
      <scroll-view class="overdue-scroll" scroll-y="{{true}}" show-scrollbar="{{false}}">
        <view class="overdue-inner">
          <view wx:for="{{multiOverdueList}}" wx:key="id" class="overdue-item">
            <view class="overdue-card course-red">
              <image class="overdue-av" src="{{item.avatarSrc}}" mode="aspectFill"></image>
              <view class="overdue-main">
                <view class="overdue-top">
                  <text class="overdue-name">{{item.studentName}}</text>
                  <view class="overdue-mini mini-red"><text>{{item.displayAmountText}}节课</text></view>
                </view>
                <text class="overdue-note" wx:if="{{item.note}}">{{item.note}}</text>
                <view class="overdue-meta-line">
                  <view class="overdue-meta"><view class="overdue-meta-ico overdue-meta-date"><text></text></view><text>{{item.dateShort}} {{item.weekday}}</text></view>
                  <view class="overdue-meta"><view class="overdue-meta-ico overdue-meta-time"><text></text></view><text>{{item.startTime}}</text></view>
                </view>
              </view>
              <view class="overdue-side">
                <view class="overdue-pill pill-red"><text>{{item.stateText}}</text></view>
              </view>
            </view>
            <view class="overdue-actions">
              <view class="overdue-act overdue-act-ok" data-id="{{item.id}}" catchtap="onMultiDeduct"><text>消课</text></view>
              <view class="overdue-act overdue-act-edit" data-id="{{item.id}}" catchtap="onMultiReschedule"><text>改期</text></view>
              <view class="overdue-act overdue-act-del" data-id="{{item.id}}" catchtap="onMultiDelete"><text>删除</text></view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="overdue-foot">
        <view class="overdue-cancel" bindtap="closeMultiOverdue"><text>取消</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 首页排课改期面板 ===== -->
  <view class="schedule-edit-mask" wx:if="{{showScheduleEdit}}" style="opacity:{{scheduleEditMaskOpacity}}" catchtap="closeScheduleEdit">
    <view class="schedule-edit-sheet" style="transform:translateY({{scheduleEditY}}px);transition:{{scheduleEditTransition}}" catchtap="nop" bindtouchstart="onScheduleEditTouchStart" bindtouchmove="onScheduleEditTouchMove" bindtouchend="onScheduleEditTouchEnd" bindtouchcancel="onScheduleEditTouchCancel">
      <view class="schedule-edit-handle"></view>
      <view class="schedule-edit-head">
        <view class="schedule-edit-side"></view>
        <text class="schedule-edit-title">编辑排课</text>
        <view class="schedule-edit-save" bindtap="saveScheduleEdit"><text>保存</text></view>
      </view>
      <scroll-view class="schedule-edit-body" scroll-y="{{scheduleEditBodyScrollEnabled}}" show-scrollbar="{{false}}" upper-threshold="24" bindscroll="onScheduleEditBodyScroll" bindscrolltoupper="onScheduleEditBodyScrollToUpper">
        <view class="schedule-edit-student">
          <image class="schedule-edit-av" src="{{scheduleEditForm.avatarSrc}}" mode="aspectFill"></image>
          <text class="schedule-edit-name">{{scheduleEditForm.studentName}}</text>
        </view>
        <view class="schedule-edit-field">
          <text class="schedule-edit-label">日期</text>
          <picker mode="date" value="{{scheduleEditForm.date}}" bindchange="onScheduleEditDate">
            <view class="schedule-edit-input schedule-edit-pick"><view class="schedule-edit-ico schedule-edit-date-ico"><text></text></view><text>{{scheduleEditForm.date}}</text><text class="schedule-edit-arrow">›</text></view>
          </picker>
        </view>
        <view class="schedule-edit-field">
          <text class="schedule-edit-label">上课时间</text>
          <picker mode="time" value="{{scheduleEditForm.startTime}}" bindchange="onScheduleEditTime">
            <view class="schedule-edit-input schedule-edit-pick"><view class="schedule-edit-ico schedule-edit-time-ico"><text></text></view><text>{{scheduleEditForm.startTime}}</text><text class="schedule-edit-arrow">›</text></view>
          </picker>
        </view>
        <view class="schedule-edit-field">
          <text class="schedule-edit-label">排课节数</text>
          <view class="schedule-edit-amount-row">
            <view class="schedule-edit-amount {{!scheduleEditForm.customSelected && scheduleEditForm.plannedAmount===1?'schedule-edit-amount-on':''}} {{scheduleEditAmountLimit < 1 ? 'schedule-edit-amount-disabled' : ''}}" data-v="1" bindtap="onScheduleEditAmountQuick"><text>1节</text></view>
            <view class="schedule-edit-amount {{!scheduleEditForm.customSelected && scheduleEditForm.plannedAmount===2?'schedule-edit-amount-on':''}} {{scheduleEditAmountLimit < 2 ? 'schedule-edit-amount-disabled' : ''}}" data-v="2" bindtap="onScheduleEditAmountQuick"><text>2节</text></view>
            <input class="schedule-edit-custom {{scheduleEditForm.customSelected?'schedule-edit-custom-on':''}} {{scheduleEditAmountShake?'schedule-edit-amount-shake':''}}" placeholder="{{scheduleEditForm.customSelected ? '' : '自定义'}}" placeholder-class="schedule-edit-placeholder" type="digit" value="{{scheduleEditForm.customAmount}}" bindfocus="onScheduleEditAmountFocus" bindtap="onScheduleEditAmountFocus" bindinput="onScheduleEditAmountInput" />
          </view>
        </view>
        <view class="schedule-edit-field">
          <text class="schedule-edit-label">上课备注</text>
          <view class="schedule-edit-ta-wrap">
            <textarea class="schedule-edit-ta" style="min-height:92rpx;max-height:210rpx" placeholder="可填写训练内容、注意事项" value="{{scheduleEditForm.note}}" maxlength="200" auto-height="{{true}}" disable-default-padding="{{true}}" bindinput="onScheduleEditNote" bindblur="onScheduleEditNoteBlur" />
            <text class="schedule-edit-count">{{scheduleEditNoteCount}}/200</text>
          </view>
        </view>
      </scroll-view>
      <view class="schedule-edit-foot">
        <view class="schedule-edit-primary" bindtap="saveScheduleEdit"><text>保存排课</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 首页排课改期确认弹窗 ===== -->
  <view class="modal modal-schedule-del" wx:if="{{showScheduleEditConfirm}}" catchtap="closeScheduleEditConfirm">
    <view class="modal-box schedule-del-box" catchtap="nop">
      <view class="sd-body">
        <text class="sd-title">{{scheduleEditConfirmTitle}}</text>
        <text class="sd-desc" wx:if="{{scheduleEditConfirmDesc}}">{{scheduleEditConfirmDesc}}</text>
      </view>
      <view class="sd-btns">
        <view class="sd-btn sd-cancel" bindtap="closeScheduleEditConfirm"><text>取消</text></view>
        <view class="sd-btn {{scheduleEditConfirmDanger?'sd-ok':'sd-save-ok'}}" bindtap="confirmScheduleEditDialog"><text>{{scheduleEditConfirmOkText}}</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 删除排课确认弹窗 ===== -->
  <view class="modal modal-schedule-del" wx:if="{{showScheduleDel}}" catchtap="closeScheduleDel">
    <view class="modal-box schedule-del-box" catchtap="nop">
      <view class="sd-body">
        <text class="sd-title">确认删除这节排课吗？</text>
      </view>
      <view class="sd-btns">
        <view class="sd-btn sd-cancel" bindtap="closeScheduleDel"><text>取消</text></view>
        <view class="sd-btn sd-ok" bindtap="doScheduleDel"><text>删除</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 消课确认弹窗 ===== -->
  <view class="modal" wx:if="{{showClass}}" catchtap="closeClass">
    <view class="modal-box modal-class" catchtap="nop">
      <view class="mc-body">
        <view class="mc-circle"><image class="mc-check-img" src="/images/class-ok.png"></image></view>
        <text class="mc-title">{{classTitle}}</text>
        <view class="mc-sub mc-schedule-sub mc-early-sub" wx:if="{{classSchedule && classScheduleState==='upcoming'}}">
          <text>原排课时间</text><text class="mc-sub-time">{{classScheduleTimeText}}</text>
        </view>
        <view class="mc-sub mc-schedule-sub mc-early-confirm" wx:if="{{classSchedule && classScheduleState==='upcoming'}}">
          <text>确认按</text><text class="mc-sub-time">{{classConfirmTimeText}}</text><text> 进行消课吗？</text>
        </view>
        <view class="mc-sub mc-schedule-sub" wx:elif="{{classSchedule && classScheduleState!=='inProgress'}}">
          <text>按</text><text class="mc-sub-time">{{classScheduleTimeText}}</text><text> 的排课处理</text>
        </view>
        <view class="mc-sub mc-move-tip" wx:if="{{classSchedule && classScheduleState==='overdue'}}">
          <text>如要 </text><text class="mc-move-red">改期</text><text> 请移至排课页面</text>
        </view>
        <view class="mc-divider" wx:if="{{classSchedule && classScheduleState!=='inProgress'}}"></view>
        <view class="mc-plan" wx:if="{{classSchedule}}">
          <text>原排课节数</text><text class="mc-plan-num">{{classScheduleAmountText}}</text><text> 节</text>
        </view>
        <view class="mc-quick">
          <view class="mc-qbtn {{!classCustomSelected && classAmount===1?'mc-qon':''}}" data-v="1" bindtap="onClassQuick">
            <text class="mc-qn">1节</text>
          </view>
          <view wx:if="{{classTarget.remainingLessons >= 2}}" class="mc-qbtn {{!classCustomSelected && classAmount===2?'mc-qon':''}}" data-v="2" bindtap="onClassQuick">
            <text class="mc-qn">2节</text>
          </view>
          <input class="mc-custom {{classCustomSelected?'mc-custom-on':''}}" type="digit" placeholder="{{classCustomSelected ? '' : '自定义'}}" value="{{classCustom}}" bindfocus="onClassCustomFocus" bindtap="onClassCustomFocus" bindinput="onClassCustom" />
        </view>
        <view class="mc-warn" wx:if="{{classSchedule && classExtraAmount > 0}}">
          <text>实际消课节数大于原排课节数，确认消课吗？</text>
        </view>
        <view class="mc-warn mc-warn-less" wx:elif="{{classSchedule && classLessAmount > 0}}">
          <text>实际消课节数小于原排课节数，确认消课吗？</text>
        </view>
        <text class="mc-desc"><text class="b">{{classTarget.name}}</text> 将扣除对应课时</text>
      </view>
      <view class="mc-btns">
        <view class="mc-btn mc-cancel" bindtap="closeClass"><text>取消</text></view>
        <view class="mc-btn mc-ok" bindtap="doClass"><text>确认消课</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 添加/编辑学员弹窗 ===== -->
  <view class="modal" wx:if="{{showForm}}" catchtap="closeForm">
    <view class="modal-box modal-form" catchtap="nop">
      <view class="mf-head"><text class="mf-title">{{editing?'编辑学员':'添加学员'}}</text></view>
      <scroll-view class="mf-body" scroll-y="true" show-scrollbar="false">
        <view class="mf-av" bindtap="randAv">
          <image class="mf-av-img" src="{{fd.avatarSrc}}" mode="aspectFill"></image>
        </view>
        <view class="mf-f">
          <text class="mf-lbl">姓名</text>
          <input class="mf-inp" placeholder="输入学员姓名" value="{{fd.name}}" bindinput="onFdName" maxlength="20" focus="{{nameFocus}}"/>
        </view>
        <view class="mf-f">
          <text class="mf-lbl">课时数</text>
          <input class="mf-inp mf-num" type="digit" placeholder="0" value="{{fd.totalLessons}}" bindinput="onFdLessons"/>
        </view>
        <view class="mf-quick">
          <view class="mq-btn {{fd.totalLessons==12?'mq-on':''}}" data-v="12" bindtap="onQuick"><text>12节</text></view>
          <view class="mq-btn {{fd.totalLessons==24?'mq-on':''}}" data-v="24" bindtap="onQuick"><text>24节</text></view>
          <view class="mq-btn {{fd.totalLessons==36?'mq-on':''}}" data-v="36" bindtap="onQuick"><text>36节</text></view>
        </view>
        <view class="mf-f">
          <text class="mf-lbl">有效期至（默认6个月）</text>
          <picker mode="date" value="{{fd.expiryDate}}" bindchange="onFdDate">
            <view class="mf-inp mf-date"><text class="{{fd.expiryDate?'':'mf-ph'}}">{{fd.expiryDate||'请选择日期'}}</text></view>
          </picker>
        </view>
        <view class="mf-f">
          <text class="mf-lbl">备注</text>
          <textarea class="mf-ta" placeholder="例如：腰椎损伤，加强核心" value="{{fd.note}}" bindinput="onFdNote" maxlength="100" auto-height="true"/>
        </view>
        <view class="mf-spacer"></view>
      </scroll-view>
      <view class="mf-foot">
        <view class="mff-btn mff-cancel" bindtap="closeForm"><text>{{editing?'关闭':'取消'}}</text></view>
        <view class="mff-btn mff-ok" bindtap="submitForm"><text>{{editing?'保存':'添加学员'}}</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 删除确认弹窗 ===== -->
  <view class="modal modal-del-mask" wx:if="{{showDel}}" catchtap="closeDel">
    <view class="modal-box modal-del" catchtap="nop">
      <view class="md-body">
        <view class="md-circle"><image class="md-ico-img" src="/images/delete-icon.png"></image></view>
        <text class="md-title">确定要删除学员吗？</text>
        <text class="md-desc"><text class="b">{{delTarget.name}}</text> 的资料、历史记录、关联排课都会删除，且<text class="b">无法恢复</text></text>
        <view class="md-warn">
          <view class="md-warn-ico"><text>!</text></view>
          <text>此操作不可撤销，请谨慎确认。</text>
        </view>
      </view>
      <view class="md-btns">
        <view class="md-btn md-cancel" bindtap="closeDel"><text>取消</text></view>
        <view class="md-btn md-ok" bindtap="doDel"><text>确定删除</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 课时过期弹窗 ===== -->
  <view class="modal" wx:if="{{showExpModal}}" catchtap="closeExpModal">
    <view class="modal-box modal-exp" catchtap="nop">
      <view class="me-body">
        <view class="me-circle"><image class="me-mark-img" src="/images/expired-icon.png"></image></view>
        <text class="me-title">该学员课时已过期</text>
        <text class="me-desc">请先前往编辑页面添加课时</text>
      </view>
      <view class="me-btns">
        <view class="me-btn" bindtap="closeExpModal"><text>确定</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 升级弹窗 ===== -->
  <view class="modal" wx:if="{{showUpg}}" catchtap="closeUpg">
    <view class="modal-box modal-upg" catchtap="nop">
      <view class="mu-head">
        <view class="mu-badge"><text>PRO VERSION</text></view>
        <view class="mu-crown"><image class="mu-crown-img" src="/images/upgrade-icon.png"></image></view>
        <text class="mu-htitle">{{upgradeTitle}}</text>
      </view>
      <view class="mu-body">
        <text class="mu-desc">免费版可管理<text class="c-green b">20位学员</text>，升级专业版后可继续添加，并保留<text class="c-green b">续费预警</text>和<text class="c-green b">数据同步</text></text>
        <view class="plan {{plan==='monthly'?'plan-on':''}}" data-plan="monthly" bindtap="onPlan">
          <view class="plan-rd {{plan==='monthly'?'rd-on':''}}"><view class="rd-dot" wx:if="{{plan==='monthly'}}"></view></view>
          <view class="plan-info"><text class="plan-n">专业版 2.9元/月</text><text class="plan-s">按月使用，适合先轻量体验</text></view>
        </view>
        <view class="plan {{plan==='lifetime'?'plan-on':''}}" data-plan="lifetime" bindtap="onPlan">
          <view class="plan-rd {{plan==='lifetime'?'rd-on':''}}"><view class="rd-dot" wx:if="{{plan==='lifetime'}}"></view></view>
          <view class="plan-info"><text class="plan-n">永久版 68元</text><text class="plan-s">一次付费，长期使用更省心</text></view>
        </view>
        <view class="mu-submit" bindtap="doUpg"><text>{{paying ? '处理中...' : '立即升级'}}</text></view>
        <view class="mu-later" bindtap="closeUpg"><text>稍后再说</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 分享奖励弹窗 ===== -->
  <view class="modal" wx:if="{{showRewardModal}}" catchtap="closeRewardModal">
    <view class="modal-box modal-class" catchtap="nop">
      <view class="mc-body">
        <view class="mc-circle"><image class="mc-check-img" src="/images/class-ok.png"></image></view>
        <text class="mc-title">{{rewardTitle}}</text>
        <text class="mc-desc" wx:if="{{rewardType==='welcome'}}">通过分享获得<text class="c-green b">{{rewardDays}}</text>专业版会员！</text>
        <text class="mc-desc" wx:elif="{{rewardType==='share'}}">分享成功，你获得<text class="c-green b">{{rewardDays}}</text>专业版会员，继续分享可获得更多会员时长！</text>
      </view>
      <view class="mc-btns">
        <view class="mc-btn mc-ok" bindtap="closeRewardModal"><text>好的</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 分享推荐弹窗 ===== -->
  <view class="modal" wx:if="{{showShareModal}}" catchtap="closeShareModal">
    <view class="modal-box modal-class" catchtap="nop">
      <view class="mc-body">
        <view class="mc-circle"><image class="mc-check-img" src="/images/upgrade-icon.png"></image></view>
        <text class="mc-title">分享得15天专业版会员</text>
        <text class="mc-desc">分享给新用户，双方各得<text class="c-green b">15天</text>专业版会员。对方首次打开即生效。</text>
      </view>
      <view class="mc-btns">
        <view class="mc-btn mc-cancel" bindtap="closeShareModal"><text>关闭</text></view>
        <button class="mc-btn mc-ok share-btn" open-type="share" bindtap="closeShareModal"><text>立即分享</text></button>
      </view>
    </view>
  </view>

  <!-- ===== 意见反馈弹窗 ===== -->
  <view class="modal" wx:if="{{showFeedback}}" catchtap="closeFeedback">
    <view class="modal-box modal-form" catchtap="nop">
      <view class="mf-head"><text class="mf-title">意见反馈</text></view>
      <view class="fb-status {{isPro ? '' : 'fb-status-gray'}}" wx:if="{{fbShowMember}}">
        <image class="fb-status-icon" src="/images/upgrade-icon.png" mode="aspectFit"></image>
        <view class="fb-status-info">
          <text class="fb-status-txt">{{isPro ? (proExpiry ? '专业版会员' : '永久版会员') : '免费版用户'}}</text>
          <text class="fb-status-sub" wx:if="{{isPro && proExpiry}}">到期日：{{proExpiry}}</text>
          <text class="fb-status-sub" wx:elif="{{isPro}}"></text>
          <text class="fb-status-sub" wx:else>升级解锁更多功能</text>
        </view>
        <view class="fb-status-btn" wx:if="{{!isPro}}" catchtap="onFbUpgrade"><text>升级</text></view>
        <view class="fb-status-btn" wx:if="{{isPro && proExpiry}}" catchtap="onFbUpgrade"><text>续费</text></view>
      </view>
      <view class="fb-body">
        <view class="mf-f">
          <text class="mf-lbl">问题与意见</text>
          <view class="fb-ta-wrap">
            <textarea class="fb-ta" placeholder="请输入您的反馈..." value="{{fbContent}}" bindinput="onFbContent" maxlength="500"/>
            <view class="fb-img-row">
              <view class="fb-img-btn" wx:for="{{fbImgs}}" wx:key="index" data-ix="{{index}}" catchtap="onFbImg">
                <image class="fb-img-thumb" src="{{item}}" mode="aspectFill"></image>
                <view class="fb-img-del" catchtap="onFbImgDel" data-ix="{{index}}"><text>×</text></view>
              </view>
              <view class="fb-img-add" wx:if="{{fbImgs.length < 3}}" catchtap="onFbAddImg">
                <view class="fb-add-h"></view>
                <view class="fb-add-v"></view>
              </view>
            </view>
          </view>
        </view>
        <view class="mf-f">
          <text class="mf-lbl">联系方式（选填）</text>
          <input class="mf-inp" placeholder="手机 / 微信 / 邮箱" value="{{fbContact}}" bindinput="onFbContact" maxlength="50"/>
        </view>
      </view>
      <view class="mf-foot">
        <view class="mff-btn mff-cancel" bindtap="closeFeedback"><text>关闭</text></view>
        <view class="mff-btn mff-ok" bindtap="submitFeedback"><text>{{feedbackSubmitting ? '提交中...' : '提交反馈'}}</text></view>
      </view>
    </view>
  </view>

  <view class="fb-preview-mask" wx:if="{{showFbPreview}}" catchtap="closeFbPreview">
    <view class="fb-preview-close" catchtap="closeFbPreview"><text>×</text></view>
    <image class="fb-preview-img" src="{{fbPreviewSrc}}" mode="aspectFit"></image>
  </view>

  <!-- ===== 彩蛋弹窗 ===== -->
  <view class="modal" wx:if="{{showEasterEgg}}">
    <!-- 礼花特效 -->
    <view class="confetti-wrap">
      <view class="cf {{item.dir}}" wx:for="{{confetti}}" wx:key="index" style="left:{{item.sx}}rpx;top:{{item.sy}}rpx;width:{{item.size}}rpx;height:{{item.size}}rpx;background:{{item.color}};border-radius:{{item.isCircle?'50%':'4rpx'}};animation-delay:{{item.delay}}s"></view>
    </view>
    <view class="modal-box modal-class" catchtap="nop">
      <view class="mc-body">
        <view class="mc-circle"><image class="mc-check-img" src="/images/class-ok.png"></image></view>
        <text class="mc-title">恭喜你发现了彩蛋~</text>
        <text class="mc-desc" wx:if="{{!easterClaimed}}">获得专业版会员一个月</text>
      </view>
      <view class="mc-btns">
        <view class="mc-btn mc-ok" bindtap="confirmEasterEgg"><text>确认</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 历史记录弹窗 ===== -->
  <view class="modal" wx:if="{{showHist}}" catchtap="closeHist">
    <view class="modal-box modal-hist" catchtap="nop">
      <view class="mh-head">
        <text class="mh-title">历史记录</text>
      </view>
      <view class="mh-sum">
        <view class="mhs-av"><image class="av-img" src="{{histData.emoji}}" mode="aspectFill"></image></view>
        <view class="mhs-info">
          <text class="mhs-name">{{histData.name}}</text>
          <view class="mhs-badge"><text>剩余 {{histData.remaining}} 节</text></view>
        </view>
      </view>
      <scroll-view class="mh-body" scroll-y="true" show-scrollbar="false">
        <text class="mhb-lbl">记录详情</text>
        <block wx:for="{{histData.records}}" wx:for-index="idx" wx:key="idx">
          <view class="hrec {{item.type==='recharge'?'hrec-g':''}}" wx:if="{{item.type !== 'undo'}}">
            <view class="hrec-l">
              <view class="hrec-ico {{item.type==='deduct'?'hri-red':'hri-gr'}}">
                <image class="hrec-ico-img" src="{{item.type==='deduct'?'/images/hist-deduct.png':'/images/hist-add.png'}}"></image>
              </view>
              <view class="hrec-info">
                <text class="hrec-act">{{item.type==='deduct'?'消课':'新增'}} <text class="hrec-num {{item.type==='deduct'?'c-red':'c-green'}}">{{item.amount}}</text> </text>
                <view class="hrec-meta-line">
                  <view class="hrec-meta">
                    <view class="hrec-meta-ico hrec-meta-date"><text></text></view>
                    <text>{{item.dateText || item.time}}</text>
                  </view>
                  <view class="hrec-meta" wx:if="{{item.timeText}}">
                    <view class="hrec-meta-ico hrec-meta-time"><text></text></view>
                    <text>{{item.timeText}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>
        <view wx:if="{{histData.records.length===0}}" class="hrec-empty"><text>暂无上课记录</text></view>
      </scroll-view>
      <view class="mh-foot">
        <view class="mhf-btn" bindtap="closeHist"><text>确认</text></view>
      </view>
    </view>
  </view>

  <view class="monthly-report-mask" wx:if="{{showMonthlyReport}}" catchtap="nop">
    <view class="monthly-report-box" catchtap="nop">
      <view class="monthly-report-head">
        <text class="monthly-report-title">{{monthlyReportData.title}}</text>
        <view class="monthly-report-close" catchtap="closeMonthlyReport"><text>×</text></view>
      </view>
      <view class="monthly-report-preview" catchtap="previewMonthlyReport">
        <image wx:if="{{monthlyReportImg}}" class="monthly-report-img" src="{{monthlyReportImg}}" mode="widthFix"></image>
        <view wx:else class="monthly-report-loading"><text>正在生成海报...</text></view>
      </view>
      <view class="monthly-report-actions">
        <view class="monthly-report-btn monthly-report-save" bindtap="saveMonthlyReport"><text>保存海报</text></view>
        <view class="monthly-report-btn monthly-report-share" bindtap="shareMonthlyReport"><text>分享海报</text></view>
      </view>
    </view>
  </view>
  <canvas canvas-id="monthlyReportCanvas" class="monthly-report-canvas"></canvas>

  <!-- Toast -->
  <view class="toast toast-undo {{showUndo?'toast-on':''}}">
    <view class="toast-left"><image class="toast-gr-img" src="/images/toast-ok.png"></image><text class="toast-wt">消课成功</text></view>
    <view class="toast-div"></view><view class="toast-link-hit" catchtap="undoClass"><text class="toast-link">点击撤销</text></view>
  </view>
  <view class="toast toast-top {{showLowT?'toast-on':''}}"><text class="toast-wt">{{lowMsg}}</text></view>
  <!-- 彩蛋toast -->
  <view class="toast easter-toast {{showEasterT?'toast-on':''}}"><text class="toast-wt">难道~被你发现了？</text></view>
  <!-- 调试面板 -->
  <view class="modal" wx:if="{{showDebug}}" catchtap="closeDebug">
    <view class="modal-box debug-panel" catchtap="nop">
      <text class="debug-title">调试面板</text>

      <view class="debug-row">
        <text class="debug-label">日期偏移</text>
        <view class="debug-btns">
          <view class="dbg-btn {{debugOffset===-30?'dbg-on':''}}" bindtap="setDebugOffset" data-v="-30"><text>-30天</text></view>
          <view class="dbg-btn {{debugOffset===-7?'dbg-on':''}}" bindtap="setDebugOffset" data-v="-7"><text>-7天</text></view>
          <view class="dbg-btn {{debugOffset===0?'dbg-on':''}}" bindtap="setDebugOffset" data-v="0"><text>今天</text></view>
          <view class="dbg-btn {{debugOffset===7?'dbg-on':''}}" bindtap="setDebugOffset" data-v="7"><text>+7天</text></view>
          <view class="dbg-btn {{debugOffset===30?'dbg-on':''}}" bindtap="setDebugOffset" data-v="30"><text>+30天</text></view>
        </view>
      </view>

      <view class="debug-row">
        <text class="debug-label">月报弹窗测试</text>
        <view class="debug-btns">
          <view class="dbg-btn" bindtap="setDebugReportDay" data-day="1"><text>下月1号</text></view>
          <view class="dbg-btn" bindtap="setDebugReportDay" data-day="2"><text>下月2号</text></view>
          <view class="dbg-btn" bindtap="setDebugReportDay" data-day="3"><text>下月3号</text></view>
          <view class="dbg-btn" bindtap="setDebugDecemberReport"><text>测试12月月报</text></view>
          <view class="dbg-btn" bindtap="clearMonthlyReportSeen"><text>重新弹月报</text></view>
        </view>
        <text class="debug-tip">模拟日期：{{debugTodayText}}，统计月份：{{debugReportMonthText}}</text>
      </view>

      <view class="debug-row">
        <text class="debug-label">课时有效期</text>
        <view class="debug-btns">
          <view class="dbg-btn {{debugExpDays===1?'dbg-on':''}}" bindtap="setDebugExp" data-v="1"><text>1天后</text></view>
          <view class="dbg-btn {{debugExpDays===7?'dbg-on':''}}" bindtap="setDebugExp" data-v="7"><text>7天后</text></view>
          <view class="dbg-btn {{debugExpDays===0?'dbg-on':''}}" bindtap="setDebugExp" data-v="0"><text>今天到期</text></view>
          <view class="dbg-btn {{debugExpDays===-1?'dbg-on':''}}" bindtap="setDebugExp" data-v="-1"><text>已过期</text></view>
        </view>
      </view>

      <view class="debug-row">
        <text class="debug-label">会员状态</text>
        <view class="debug-btns">
          <view class="dbg-btn {{debugMember===0?'dbg-on':''}}" bindtap="setDebugMember" data-v="0"><text>免费</text></view>
          <view class="dbg-btn {{debugMember===1?'dbg-on':''}}" bindtap="setDebugMember" data-v="1"><text>已到期</text></view>
          <view class="dbg-btn {{debugMember===2?'dbg-on':''}}" bindtap="setDebugMember" data-v="2"><text>已付费</text></view>
          <view class="dbg-btn {{debugMember===3?'dbg-on':''}}" bindtap="setDebugMember" data-v="3"><text>7天过期</text></view>
        </view>
      </view>

      <view class="debug-row">
        <text class="debug-label">快捷操作</text>
        <view class="debug-btns">
        <text class="debug-label">分享奖励测试</text>
        <view class="debug-row" style="display:flex;gap:12rpx">
          <view class="dbg-btn" bindtap="testWelcome"><text>被分享者弹窗</text></view>
          <view class="dbg-btn" bindtap="testReward"><text>分享者弹窗</text></view>
        </view>
          <view class="dbg-btn dbg-warn" bindtap="resetDebug"><text>恢复默认</text></view>
          <view class="dbg-btn dbg-warn" bindtap="clearAllData"><text>清空数据</text></view>
        </view>
      </view>

      <view class="debug-row">
        <text class="debug-label">当前模拟: {{debugOffset===0?'今天':(debugOffset>0?'+'+debugOffset+'天':debugOffset+'天')}} | 会员{{debugMember===0?'免费':(debugMember===1?'已到期':'已付费')}}</text>
      </view>

      <view class="debug-close" bindtap="closeDebug"><text>关闭</text></view>
    </view>
  </view>

  <view class="modal modal-schedule-del" wx:if="{{showDebugClearConfirm}}" catchtap="closeDebugClearConfirm">
    <view class="modal-box schedule-del-box" catchtap="nop">
      <view class="sd-body">
        <text class="sd-title">确认清空全部数据吗？</text>
        <text class="sd-desc">所有学员、历史记录和排课都会删除，无法恢复。</text>
      </view>
      <view class="sd-btns">
        <view class="sd-btn sd-cancel" bindtap="closeDebugClearConfirm"><text>取消</text></view>
        <view class="sd-btn sd-ok" bindtap="doClearAllData"><text>清空</text></view>
      </view>
    </view>
  </view>

  <view class="toast toast-bot {{showOkT?'toast-on':''}}">
    <view class="toast-left"><image class="toast-gr-img" src="/images/toast-ok.png"></image><text class="toast-wt">{{okMsg}}</text></view>
  </view>
</view>
