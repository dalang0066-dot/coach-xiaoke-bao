.schedule-edit-foot{ padding:14rpx 44rpx 64rpx; flex-shrink:0; background:#fff }
.schedule-edit-primary{ height:92rpx; border-radius:92rpx; background:#008946; color:#fff; display:flex; align-items:center; justify-content:center; font-size:32rpx; font-weight:900; box-shadow:0 16rpx 42rpx rgba(0,137,70,.18) }
.schedule-edit-primary:active,.schedule-edit-save:active{ transform:scale(.98); opacity:.86 }

.monthly-report-mask{ position:fixed; top:0; left:0; right:0; bottom:0; z-index:245; background:rgba(17,24,27,.45); display:flex; align-items:center; justify-content:center; padding:28rpx 24rpx; box-sizing:border-box }
