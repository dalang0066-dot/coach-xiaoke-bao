/* 绀艰姳鐗规晥 */
.confetti-wrap{ position:fixed; top:0; left:0; right:0; bottom:0; z-index:210; pointer-events:none; overflow:hidden }
.cf{ position:absolute; opacity:0; animation-fill-mode:forwards; animation-timing-function:ease-out }
.cf.cf-down{ animation-name:cfDown; animation-duration:1.2s }
.cf.cf-up{ animation-name:cfUp; animation-duration:1.2s }
.cf.cf-right{ animation-name:cfRight; animation-duration:1.2s }
.cf.cf-left{ animation-name:cfLeft; animation-duration:1.2s }
@keyframes cfDown {
  0%{ transform:translate(0,0) rotate(0deg) scale(1); opacity:1 }
  100%{ transform:translate(0,1200rpx) rotate(720deg) scale(0); opacity:0 }
}
@keyframes cfUp {
  0%{ transform:translate(0,0) rotate(0deg) scale(1); opacity:1 }
  100%{ transform:translate(0,-1200rpx) rotate(720deg) scale(0); opacity:0 }
}
@keyframes cfRight {
  0%{ transform:translate(0,0) rotate(0deg) scale(1); opacity:1 }
  100%{ transform:translate(600rpx,0) rotate(720deg) scale(0); opacity:0 }
}
@keyframes cfLeft {
  0%{ transform:translate(0,0) rotate(0deg) scale(1); opacity:1 }
  100%{ transform:translate(-600rpx,0) rotate(720deg) scale(0); opacity:0 }
}

