


.c-gray{ color:#5c5f60 }

.topbar-tt{ display:block; font-size:40rpx; font-weight:600; color:#161d1f; text-align:left; padding-left:35rpx; line-height:88rpx; flex-shrink:0; position:relative; z-index:1 }
.topbar-white{ background:#fff }
.top-ico{ position:fixed; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,.9); border:1rpx solid rgba(0,0,0,.08); z-index:51 }
.top-ico:active{ background:rgba(0,0,0,.1) }
.top-ico-img{ width:90%; height:90% }

/* 空状态 */
.empty-scroll{ position:absolute; top:0; left:0; right:0; bottom:0; z-index:0 }
.empty-bg{ display:block; width:100% }
.big-btn{ position:fixed; left:50rpx; right:50rpx; bottom:60rpx; height:140rpx; border-radius:35rpx; background:#006d37; display:flex; align-items:center; justify-content:space-between; padding:0 50rpx; box-shadow:0 16rpx 48rpx rgba(0,109,55,.3); z-index:2 }
.big-btn-text{ font-size:25rpx; font-weight:500; color:#fff; margin-top:-2rpx }
.big-btn-icon{ width:55rpx; height:55rpx; flex-shrink:0 }
.big-btn:active{ transform:scale(.98) }
.big-btn-text{ font-size:48rpx; font-weight:600; color:#fff }
.big-btn:active{ transform:scale(.95) }
.plus-wrap{ position:relative; width:76rpx; height:76rpx }
.plus-h{ position:absolute; top:50%; left:0; right:0; height:12rpx; background:#fff; border-radius:6rpx; transform:translateY(-50%) }
.plus-v{ position:absolute; left:50%; top:0; bottom:0; width:12rpx; background:#fff; border-radius:6rpx; transform:translateX(-50%) }

/* 横幅 */
.banner{ display:flex; align-items:center; justify-content:space-between; padding:10rpx 32rpx; background:#FEF3C7; flex-shrink:0; border-bottom:2rpx solid rgba(146,64,14,.15) }
.banner-l{ display:flex; align-items:center; gap:12rpx; flex:1 }
.banner-ico{ flex-shrink:0 }
.banner-txt{ font-size:28rpx; color:#92400E; line-height:1.4 }
.banner-x{ width:72rpx; height:72rpx; display:flex; align-items:center; justify-content:center; opacity:.7 }
.banner-x text{ font-size:42rpx; color:#92400E; line-height:1 }

/* 列表 */
.list-scroll{ flex:1; min-height:0 }
.list-wrap{ padding:40rpx 32rpx }
.pad-bot{ height:140rpx }

/* 卡片 */
.card-box{ position:relative; border-radius:24rpx; margin-bottom:24rpx; overflow:hidden; box-shadow:0 8rpx 24rpx rgba(0,0,0,.04); background:#fff }
.card-actions{ position:absolute; top:1rpx; right:2rpx; bottom:1rpx; display:flex; z-index:1; border-radius:0 24rpx 24rpx 0; overflow:hidden }
.card-box.card-open .card-actions{ z-index:3 }
.act-btn{ width:140rpx; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#fff; font-size:22rpx; font-weight:500; gap:0 }
.act-btn text{ margin-top:-2rpx }
.act-ico{ width:56rpx; height:56rpx }
.banner-ico-img{ width:48rpx; height:48rpx }
.mc-check-img{ width:150rpx; height:150rpx }
.toast-gr-img{ width:52rpx; height:52rpx }
.md-ico-img{ width:150rpx; height:150rpx }
.me-mark-img{ width:150rpx; height:150rpx }
.mu-crown-img{ width:140rpx; height:140rpx }
.hrec-ico-img{ width:90rpx; height:90rpx }
.act-edit{ background:#3498db }
.act-hist{ background:#f39c12 }
.act-del{ background:#ba1a1a }

.card-main{ display:flex; align-items:center; padding:32rpx 28rpx; position:relative; z-index:2; background:#fff; transition:transform .25s ease }
.card-swiped{ transform:translateX(-354rpx) }
.card-hl-green{ box-shadow:0 0 0 4rpx rgba(0,109,55,.35), 0 8rpx 24rpx rgba(0,0,0,.04) }
.card-hl-red{ box-shadow:0 0 0 4rpx rgba(186,26,26,.35), 0 8rpx 24rpx rgba(0,0,0,.04) }
.card-gray.card-main{ background:#e5eaec }
.card-red.card-main{ background:#fff5f5; border-left:8rpx solid #ba1a1a }
.card-main.card-hint{ animation: swipeHint 1.5s ease-in-out }
.card-hint-tip{ text-align:center; padding:20rpx 0 8rpx }
.card-hint-tip text{ font-size:30rpx; color:#006d37; background:rgba(46,204,113,.12); padding:14rpx 36rpx; border-radius:48rpx }
@keyframes swipeHint {
  0%{ left:0 }
  25%{ left:-70rpx }
  50%{ left:0 }
  75%{ left:-70rpx }
  100%{ left:0 }
}

.card-av{ width:108rpx; height:108rpx; border-radius:50%; margin-right:28rpx; flex-shrink:0; overflow:hidden }
.av-img{ width:100%; height:100%; border-radius:50% }

.card-info{ flex:1; min-width:0 }
.card-name{ display:block; font-size:42rpx; font-weight:600; color:#161d1f; overflow:hidden; text-overflow:ellipsis; white-space:nowrap }
.card-note{ display:block; font-size:30rpx; color:#5c5f60; margin-top:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap }

.card-num{ text-align:right; flex-shrink:0; margin-left:28rpx }
.num-val{ display:block; font-size:48rpx; font-weight:600; line-height:1.09 }
.num-lbl{ display:block; font-size:24rpx; font-weight:600; color:#5c5f60; margin-top:4rpx }

.no-result{ text-align:center; padding:120rpx 0 }

/* 底部栏 */
.bot-bar{ position:fixed; left:0; right:0; bottom:0; display:flex; align-items:center; padding:22rpx 32rpx 12rpx 32rpx; background:#fff; box-shadow:0 -8rpx 24rpx rgba(0,0,0,.04); z-index:60; transition:bottom .25s ease }
.search-wrap{ flex:7; position:relative; margin-right:16rpx }
.search-icon-wrap{ position:absolute; left:16rpx; top:50%; transform:translateY(-50%); z-index:1; display:flex }
.search-ico-img{ width:62rpx; height:62rpx }
.search-inp{ width:100%; height:98rpx; padding-left:86rpx; padding-right:72rpx; background:#e8eff1; border-radius:24rpx; font-size:32rpx; color:#161d1f; box-sizing:border-box }
.search-clear{ position:absolute; right:6rpx; top:50%; transform:translateY(-50%); width:64rpx; height:64rpx; display:flex; align-items:center; justify-content:center; opacity:.45 }
.search-clear text{ font-size:40rpx; color:#161d1f; line-height:1 }
.add-btn2{ flex:3; display:flex; align-items:center; justify-content:center; gap:8rpx; background:#006d37; color:#fff; padding:0 16rpx; height:98rpx; border-radius:24rpx; font-size:32rpx; font-weight:500; white-space:nowrap }
.add-btn2:active{ transform:scale(.95) }
.add-plus-wrap{ position:relative; width:28rpx; height:28rpx }
.add-plus-h{ position:absolute; top:50%; left:0; right:0; height:5rpx; background:#fff; border-radius:3rpx; transform:translateY(-50%) }
.add-plus-v{ position:absolute; left:50%; top:0; bottom:0; width:5rpx; background:#fff; border-radius:3rpx; transform:translateX(-50%) }

/* 弹窗 */
.modal{ position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(22,29,31,.4); z-index:200; display:flex; align-items:center; justify-content:center; padding:32rpx 24rpx }
.modal-box{ background:#fff; border-radius:56rpx; box-shadow:0 48rpx 96rpx rgba(0,0,0,.12); width:100%; box-sizing:border-box }

/* 消课 */
.modal-class{ max-width:600rpx }
.mc-body,.md-body,.me-body{ padding:36rpx 64rpx 0; text-align:center; display:flex; flex-direction:column; align-items:center }
.mc-circle{ display:flex; align-items:center; justify-content:center; margin-top:14rpx; margin-bottom:28rpx }
.mc-title{ font-size:40rpx; font-weight:600; color:#161d1f; margin-bottom:8rpx; text-align:center; width:100%; padding-left:15rpx }
.mc-desc{ font-size:28rpx; color:#5c5f60; line-height:1.5; margin-top:20rpx; text-align:center; width:100%; padding-left:15rpx }
.mc-quick{ display:flex; gap:16rpx; margin-top:28rpx; width:100% }
.mc-qbtn{ flex:1; height:120rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; border-radius:24rpx; border:2rpx solid #bbcbbb; color:#3d4a3e }
.mc-qbtn:active{ transform:scale(.95) }
.mc-qon{ border:4rpx solid #006d37; background:rgba(46,204,113,.1) }
.mc-qn{ font-size:34rpx; font-weight:600; color:#161d1f }
.mc-qon .mc-qn{ color:#006d37 }
.mc-qs{ font-size:22rpx; color:#5c5f60; margin-top:2rpx }
.mc-btns{ display:flex; gap:24rpx; padding:48rpx }
.mc-btn{ flex:1; height:88rpx; border-radius:88rpx; display:flex; align-items:center; justify-content:center; font-size:34rpx; font-weight:500 }
.mc-btn:active{ transform:scale(.98); opacity:.8 }
.mc-cancel{ border:2rpx solid #bbcbbb; color:#5c5f60 }
.mc-ok{ background:#006d37; color:#fff; box-shadow:0 16rpx 48rpx rgba(0,109,55,.16) }
.share-btn{ padding:0; margin:0; border:none; line-height:inherit; font-size:inherit }

/* 表单 */
.modal-form{ max-width:640rpx; width:100%; max-height:85vh; display:flex; flex-direction:column; box-sizing:border-box; overflow:hidden }
.mf-head{ display:flex; align-items:center; justify-content:center; min-height:88rpx; border-bottom:2rpx solid rgba(221,228,230,.3); flex-shrink:0 }
.mf-title{ font-size:40rpx; font-weight:600; color:#161d1f; line-height:88rpx }
.mf-body{ flex:1; padding:24rpx 32rpx 0; overflow-x:hidden; min-height:500rpx; box-sizing:border-box }
.fb-body{ padding:16rpx 32rpx 0 }
.fb-status{ display:flex; align-items:center; gap:24rpx; margin:12rpx 32rpx 8rpx; padding:28rpx 36rpx; background:#eef5f7; border-radius:28rpx; flex-shrink:0 }
.fb-status-gray{ background:#f5f5f5 }
.fb-status-gray .fb-status-icon{ opacity:.35 }
.fb-status-gray .fb-status-txt{ color:#9ca3af }
.fb-status-icon{ width:100rpx; height:100rpx; flex-shrink:0 }
.fb-status-info{ flex:1 }
.fb-status-txt{ display:block; font-size:32rpx; font-weight:600; color:#161d1f }
.fb-status-sub{ display:block; font-size:24rpx; color:#161d1f; margin-top:4rpx }
.fb-status-btn{ flex-shrink:0; padding:16rpx 36rpx; border-radius:48rpx; background:#006d37; color:#fff; font-size:28rpx; font-weight:500 }
.fb-status-btn:active{ opacity:.8 }
.fb-ta-wrap{ background:#e8eff1; border-bottom:4rpx solid #bbcbbb; border-radius:16rpx 16rpx 0 0; padding:20rpx 24rpx; overflow:hidden }
.fb-ta{ width:100%; height:160rpx; font-size:32rpx; color:#161d1f; box-sizing:border-box; margin:0; overflow-x:hidden }
.fb-img-row{ display:flex; gap:16rpx; padding-top:20rpx; flex-wrap:wrap }
.fb-img-btn{ width:120rpx; height:120rpx; border-radius:12rpx; overflow:hidden; position:relative }
.fb-img-thumb{ width:100%; height:100% }
.fb-img-del{ position:absolute; top:-4rpx; right:-4rpx; width:36rpx; height:36rpx; border-radius:50%; background:rgba(0,0,0,.5); display:flex; align-items:center; justify-content:center }
.fb-img-del text{ font-size:20rpx; color:#fff; line-height:1 }
.fb-img-add{ width:120rpx; height:120rpx; border-radius:12rpx; border:3rpx dashed #bbcbbb; display:flex; align-items:center; justify-content:center; position:relative; flex-shrink:0 }
.fb-img-add:active{ background:rgba(0,0,0,.04) }
.fb-add-h{ position:absolute; width:40rpx; height:4rpx; background:#9ca3af; border-radius:2rpx }
.fb-add-v{ position:absolute; width:4rpx; height:40rpx; background:#9ca3af; border-radius:2rpx }
.mf-av{ width:160rpx; height:160rpx; border-radius:50%; margin:16rpx auto 32rpx; display:flex; align-items:center; justify-content:center; position:relative; flex-shrink:0; overflow:hidden }
.mf-av:active{ transform:scale(.95) }
.mf-av-img{ width:100%; height:100%; border-radius:50% }
.mf-f{ margin-bottom:28rpx; width:100% }
.mf-lbl{ display:block; font-size:24rpx; font-weight:600; color:#5c5f60; padding:0 4rpx; margin-bottom:6rpx }
.mf-inp{ width:100%; height:90rpx; background:#e8eff1; border-bottom:4rpx solid #bbcbbb; border-radius:16rpx 16rpx 0 0; padding:0 24rpx; font-size:32rpx; color:#161d1f; box-sizing:border-box; margin:0 }
.mf-num{ font-family:'Lexend',sans-serif }
.mf-date{ display:flex; align-items:center }
.mf-ph{ color:#9ca3af }
.mf-ta{ width:100%; min-height:110rpx; background:#e8eff1; border-bottom:4rpx solid #bbcbbb; border-radius:16rpx 16rpx 0 0; padding:20rpx 24rpx; font-size:32rpx; color:#161d1f; box-sizing:border-box; margin:0; overflow-x:hidden }
.mf-quick{ display:flex; gap:12rpx; margin-bottom:24rpx; width:100% }
.mq-btn{ flex:1; height:72rpx; display:flex; align-items:center; justify-content:center; border-radius:24rpx; border:2rpx solid #bbcbbb; font-size:28rpx; color:#3d4a3e }
.mq-btn:active{ transform:scale(.95) }
.mq-on{ border:4rpx solid #006d37; background:rgba(46,204,113,.1); color:#006d37 }
.mf-spacer{ height:0 }
.mf-foot{ display:flex; gap:28rpx; padding:0 40rpx 0; flex-shrink:0 }
.mff-btn{ height:88rpx; display:flex; align-items:center; justify-content:center; font-size:30rpx; font-weight:500; margin-top:20rpx; margin-bottom:35rpx }
.mff-btn:active{ transform:scale(.95) }
.mff-cancel{ flex:1; border:2rpx solid #bbcbbb; color:#5c5f60; border-radius:88rpx }
.mff-ok{ flex:1; background:#006d37; color:#fff; border-radius:88rpx; box-shadow:0 16rpx 48rpx rgba(0,109,55,.16) }

/* 删除 */
.modal-del{ max-width:600rpx }
.md-circle{ display:flex; align-items:center; justify-content:center; margin-bottom:40rpx }
.md-title{ font-size:40rpx; font-weight:600; color:#161d1f; margin-bottom:12rpx }
.md-desc{ font-size:28rpx; color:#3d4a3e; margin-bottom:0; line-height:1.5 }
.md-btns{ display:flex; gap:24rpx; padding:48rpx }
.md-btn{ flex:1; height:88rpx; border-radius:88rpx; display:flex; align-items:center; justify-content:center; font-size:34rpx; font-weight:500 }
.md-btn:active{ opacity:.8 }
.md-cancel{ border:2rpx solid #bbcbbb; color:#5c5f60 }
.md-ok{ background:#b4271d; color:#fff }

/* 课时过期 */
.modal-exp{ max-width:600rpx }
.me-circle{ display:flex; align-items:center; justify-content:center; margin-bottom:40rpx }
.me-title{ font-size:40rpx; font-weight:600; color:#161d1f; margin-bottom:12rpx }
.me-desc{ font-size:28rpx; color:#5c5f60; margin-bottom:0 }
.me-btns{ display:flex; gap:24rpx; padding:48rpx; justify-content:center }
.me-btn{ flex:1; height:88rpx; border-radius:88rpx; display:flex; align-items:center; justify-content:center; font-size:34rpx; font-weight:500; background:#006d37; color:#fff; box-shadow:0 16rpx 48rpx rgba(0,109,55,.16) }
.me-btn:active{ transform:scale(.98); opacity:.8 }

/* 升级 */
.modal-upg{ max-width:600rpx; border-radius:56rpx; overflow:hidden }
.mu-head{ background:linear-gradient(135deg,#006d37,#2ecc71); padding:56rpx 56rpx 40rpx; display:flex; flex-direction:column; align-items:center; position:relative }
.mu-badge{ position:absolute; top:24rpx; right:24rpx; background:rgba(255,255,255,.2); border:2rpx solid rgba(255,255,255,.3); border-radius:96rpx; padding:6rpx 20rpx }
.mu-badge text{ font-size:22rpx; font-weight:600; color:#fff }
.mu-crown{ display:flex; align-items:center; justify-content:center; margin-bottom:24rpx }
.mu-htitle{ font-size:40rpx; font-weight:700; color:#fff }
.mu-body{ padding:40rpx }
.mu-desc{ font-size:28rpx; color:#5c5f60; line-height:1.7; text-align:center; display:block; margin-bottom:36rpx }
.plan{ display:flex; align-items:center; gap:28rpx; padding:28rpx; border-radius:24rpx; border:4rpx solid #bbcbbb; margin-bottom:20rpx }
.plan-on{ border-color:#006d37; background:rgba(46,204,113,.1) }
.plan-rd{ width:36rpx; height:36rpx; border-radius:50%; border:4rpx solid #bbcbbb; display:flex; align-items:center; justify-content:center; flex-shrink:0 }
.rd-on{ border-color:#006d37 }
.rd-dot{ width:20rpx; height:20rpx; border-radius:50%; background:#006d37 }
.plan-info{ flex:1 }
.plan-n{ display:block; font-size:30rpx; font-weight:600; color:#161d1f; margin-bottom:4rpx }
.plan-s{ display:block; font-size:26rpx }
.mu-submit{ width:100%; height:100rpx; border-radius:100rpx; background:linear-gradient(135deg,#006d37,#2ecc71); display:flex; align-items:center; justify-content:center; color:#fff; font-size:38rpx; font-weight:600; box-shadow:0 16rpx 48rpx rgba(0,109,55,.2); margin-top:28rpx }
.mu-submit:active{ transform:scale(.95) }
.mu-later{ text-align:center; padding:28rpx 0 0; font-size:32rpx; color:#5c5f60 }

/* 历史记录弹窗 */
.modal-hist{ max-width:640rpx; max-height:85vh; display:flex; flex-direction:column; overflow:hidden }
.mh-head{ display:flex; align-items:center; justify-content:center; height:88rpx; flex-shrink:0 }
.mh-title{ font-size:40rpx; font-weight:600; color:#161d1f }
.mh-sum{ display:flex; align-items:center; gap:24rpx; margin:12rpx 32rpx 16rpx; padding:36rpx; background:#eef5f7; border-radius:28rpx; flex-shrink:0 }
.mhs-av{ width:140rpx; height:140rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; overflow:hidden }
.mhs-info{ flex:1 }
.mhs-name{ display:block; font-size:36rpx; font-weight:600; color:#161d1f; margin-bottom:6rpx }
.mhs-badge{ display:inline-flex; background:rgba(46,204,113,.15); padding:5rpx 18rpx; border-radius:96rpx }
.mhs-badge text{ font-size:24rpx; font-weight:600; color:#006d37 }
.mh-body{ padding:0 28rpx; min-height:200rpx; max-height:52vh }
.mhb-lbl{ display:block; font-size:32rpx; font-weight:600; color:#5c5f60; padding-bottom:16rpx }
.hrec{ background:#fff; border-radius:20rpx; border:2rpx solid rgba(221,228,230,.3); padding:18rpx; margin-bottom:16rpx; box-sizing:border-box; overflow:hidden }
.hrec-g{ border-left:6rpx solid #2ecc71 }
.hrec-l{ display:flex; align-items:center; gap:28rpx }
.hrec-ico{ display:flex; align-items:center; justify-content:center; flex-shrink:0 }
.hri-red{ color:#ba1a1a }
.hri-yel{ color:#ca8a04 }
.hri-gr{ color:#006d37 }
.hrec-info{ flex:1; min-width:0; overflow:hidden }
.hrec-act{ display:block; font-size:32rpx; color:#161d1f }
.hrec-num{ font-weight:600 }
.hrec-time{ display:block; font-size:26rpx; color:#5c5f60; margin-top:4rpx }
.hrec-empty{ text-align:center; padding:100rpx 0; color:#5c5f60 }
.mh-foot{ padding:0 32rpx 0; flex-shrink:0 }
.mhf-btn{ width:100%; height:84rpx; border-radius:84rpx; background:#006d37; display:flex; align-items:center; justify-content:center; color:#fff; font-size:28rpx; font-weight:500; margin-top:20rpx; margin-bottom:35rpx; flex-shrink:0 }

/* Toast */
.toast{ position:fixed; left:50%; transform:translateX(-50%); z-index:150; background:#2b3234; color:#f4fafd; border-radius:96rpx; padding:22rpx 40rpx; display:flex; align-items:center; gap:16rpx; box-shadow:0 20rpx 50rpx -10rpx rgba(0,0,0,.1); opacity:0; pointer-events:none; transition:opacity .3s }
.toast-on{ opacity:1; pointer-events:auto }
.toast-undo{ bottom:210rpx; justify-content:center; gap:24rpx; flex-wrap:nowrap }
.toast-top{ bottom:315rpx; left:50%; transform:translateX(-50%) }
.easter-toast{ bottom:220rpx; top:auto; left:50%; transform:translateX(-50%) }
.toast-bot{ bottom:210rpx; justify-content:center }
.toast-left{ display:flex; align-items:center; gap:12rpx; white-space:nowrap; flex-shrink:0 }
.toast-gr{ display:flex; align-items:center }
.toast-wt{ color:#f4fafd; font-size:30rpx; font-weight:500; white-space:nowrap }
.toast-div{ width:2rpx; height:28rpx; background:#dde4e6; flex-shrink:0 }
.toast-link{ color:#6bfe9c; font-size:30rpx; font-weight:500; white-space:nowrap }
.toast-link:active{ opacity:.7 }

/* 礼花特效 */
.confetti-wrap{ position:fixed; top:0; left:0; right:0; bottom:0; z-index:210; pointer-events:none; overflow:hidden }
.cf{ position:absolute; opacity:0; animation-fill-mode:forwards; animation-timing-function:ease-out }
.cf.cf-down{ animation-name:cfDown; animation-duration:1.2s }
.cf.cf-up{ animation-name:cfUp; animation-duration:1.2s }
.cf.cf-right{ animation-name:cfRight; animation-duration:1.2s }
.cf.cf-left{ animation-name:cfLeft; animation-duration:1.2s }
@keyframes cfDown {
  0%{ transform:translate(0,0) rotate(0deg) scale(1); opacity:1 }
  100%{ transform:translate(0,1200rpx) rotate(720deg) scale(0); opacity:0 }
}
@keyframes cfUp {
  0%{ transform:translate(0,0) rotate(0deg) scale(1); opacity:1 }
  100%{ transform:translate(0,-1200rpx) rotate(720deg) scale(0); opacity:0 }
}
@keyframes cfRight {
  0%{ transform:translate(0,0) rotate(0deg) scale(1); opacity:1 }
  100%{ transform:translate(600rpx,0) rotate(720deg) scale(0); opacity:0 }
}
@keyframes cfLeft {
  0%{ transform:translate(0,0) rotate(0deg) scale(1); opacity:1 }
  100%{ transform:translate(-600rpx,0) rotate(720deg) scale(0); opacity:0 }
}

/* 调试面板 */
.debug-panel{ max-width:600rpx; padding:40rpx; background:#fff; border-radius:56rpx }
.debug-title{ display:block; font-size:40rpx; font-weight:600; color:#161d1f; text-align:center; margin-bottom:32rpx }
.debug-row{ margin-bottom:24rpx }
.debug-label{ display:block; font-size:26rpx; color:#5c5f60; margin-bottom:12rpx }
.debug-btns{ display:flex; gap:12rpx; flex-wrap:wrap }
.dbg-btn{ padding:12rpx 24rpx; border-radius:96rpx; border:2rpx solid #bbcbbb; font-size:26rpx; color:#3d4a3e; background:#fff }
.dbg-on{ border-color:#006d37; background:rgba(46,204,113,.1); color:#006d37 }
.dbg-warn{ border-color:#b4271d; color:#b4271d }
.debug-close{ height:88rpx; border-radius:88rpx; background:#006d37; display:flex; align-items:center; justify-content:center; color:#fff; font-size:34rpx; font-weight:500; margin-top:24rpx }