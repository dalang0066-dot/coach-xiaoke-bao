.schedule-edit-placeholder{ color:#a8b2b7; font-weight:700 }
.schedule-edit-amount-shake{ animation:scheduleEditAmountShake .32s ease }
@keyframes scheduleEditAmountShake{ 0%,100%{ transform:translateX(0) } 20%{ transform:translateX(-8rpx) } 40%{ transform:translateX(7rpx) } 60%{ transform:translateX(-5rpx) } 80%{ transform:translateX(4rpx) } }
