


.c-gray{ color:#5c5f60 }

.topbar{ display:flex; align-items:center; justify-content:center; height:88rpx; background:#fff; flex-shrink:0; z-index:50; padding-left:32rpx; padding-right:32rpx; border-bottom:2rpx solid #e8eff1 }
.topbar-tt{ font-size:40rpx; font-weight:600; color:#161d1f; line-height:88rpx }

/* 空状态 */
.empty-scroll{ flex:1; min-height:0 }
.guide-box{ width:100%; height:530px; position:relative; overflow:hidden; background:#fff }
.guide-sw{ width:100%; height:100% }
.guide-s1,.guide-s2,.guide-s3{ width:100%; height:100%; display:flex; align-items:center; justify-content:center; position:relative }
.guide-s1{ background:linear-gradient(135deg,#e8f5e9,#c8e6c9,#a5d6a7) }
.guide-s2{ background:linear-gradient(135deg,#e3f2fd,#bbdefb,#90caf9) }
.guide-s3{ background:linear-gradient(135deg,#fce4ec,#f8bbd0,#f48fb1) }
.guide-txt{ position:absolute; bottom:100rpx; left:0; right:0; padding:0 48rpx; text-align:center; z-index:2 }
.guide-h{ display:block; font-size:48rpx; font-weight:600; color:#fff; text-shadow:0 4rpx 12rpx rgba(0,0,0,.3); margin-bottom:16rpx }
.guide-p{ display:block; font-size:28rpx; color:rgba(255,255,255,.9); text-shadow:0 2rpx 8rpx rgba(0,0,0,.2) }
.guide-grad{ position:absolute; bottom:0; left:0; right:0; height:120rpx; background:linear-gradient(180deg,rgba(255,255,255,0),rgba(244,250,253,1) 90%); z-index:1 }
.empty-act{ display:flex; flex-direction:column; align-items:center; padding-top:96rpx; padding-bottom:80rpx }
.empty-hint{ font-size:36rpx; font-weight:500; color:#5c5f60; margin-bottom:48rpx }
.big-btn{ width:200rpx; height:200rpx; border-radius:50%; background:#006d37; display:flex; align-items:center; justify-content:center; box-shadow:0 16rpx 48rpx rgba(0,109,55,.3) }
.big-btn:active{ transform:scale(.95) }
.big-btn-icon{ font-size:112rpx; color:#fff; font-weight:300; line-height:1 }

/* 横幅 */
.banner{ display:flex; align-items:center; justify-content:space-between; padding:20rpx 32rpx; background:#FEF3C7; flex-shrink:0 }
.banner-l{ display:flex; align-items:center; gap:12rpx; flex:1 }
.banner-ico{ font-size:28rpx; color:#92400E; font-weight:700; width:40rpx; height:40rpx; border-radius:50%; background:rgba(146,64,14,.1); display:flex; align-items:center; justify-content:center; flex-shrink:0 }
.banner-txt{ font-size:28rpx; color:#92400E; line-height:1.4 }
.banner-x{ width:48rpx; height:48rpx; display:flex; align-items:center; justify-content:center; opacity:.7 }
.banner-x text{ font-size:28rpx; color:#92400E }

/* 列表 */
.list-scroll{ flex:1; min-height:0 }
.list-wrap{ padding:40rpx 32rpx }
.pad-bot{ height:40rpx }

/* 卡片 */
.card-box{ position:relative; border-radius:24rpx; margin-bottom:24rpx; overflow:hidden; box-shadow:0 8rpx 24rpx rgba(0,0,0,.04); background:#fff }
.card-actions{ position:absolute; top:1rpx; right:2rpx; bottom:1rpx; display:flex; z-index:1; border-radius:0 24rpx 24rpx 0; overflow:hidden }
.card-box.card-open .card-actions{ z-index:3 }
.act-btn{ width:118rpx; height:100%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:24rpx; font-weight:500 }
.act-edit{ background:#3498db }
.act-hist{ background:#f39c12 }
.act-del{ background:#ba1a1a }

.card-main{ display:flex; align-items:center; padding:36rpx; position:relative; z-index:2; background:#fff; transition:transform .25s ease }
.card-swiped{ transform:translateX(-354rpx) }
.card-hl{ background:#e8fce8 !important }
.card-gray.card-main{ background:#e5eaec }
.card-red.card-main{ background:#fff5f5; border-left:8rpx solid #ba1a1a }

.card-av{ width:96rpx; height:96rpx; border-radius:50%; margin-right:28rpx; flex-shrink:0; display:flex; align-items:center; justify-content:center; background:rgba(46,204,113,.2) }
.av-gray{ background:#e1e3e4 }
.av-emoji{ font-size:56rpx; line-height:1 }

.card-info{ flex:1; min-width:0 }
.card-name{ display:block; font-size:40rpx; font-weight:600; color:#161d1f; overflow:hidden; text-overflow:ellipsis; white-space:nowrap }
.card-note{ display:block; font-size:28rpx; color:#5c5f60; margin-top:4rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap }

.card-num{ text-align:right; flex-shrink:0; margin-left:28rpx }
.num-val{ display:block; font-size:44rpx; font-weight:600; line-height:1.09 }
.num-lbl{ display:block; font-size:24rpx; font-weight:600; color:#5c5f60; margin-top:4rpx }

.no-result{ text-align:center; padding:120rpx 0 }

/* 底部栏 */
.bot-bar{ display:flex; align-items:center; padding:16rpx 32rpx; background:#fff; box-shadow:0 -8rpx 24rpx rgba(0,0,0,.04); flex-shrink:0; padding-bottom:calc(16rpx + env(safe-area-inset-bottom)) }
.search-wrap{ flex:1; position:relative; margin-right:16rpx }
.search-icon-wrap{ position:absolute; left:18rpx; top:50%; transform:translateY(-50%); z-index:1 }
.search-icon-wrap text{ font-size:30rpx }
.search-inp{ width:100%; height:88rpx; padding-left:62rpx; padding-right:20rpx; background:#e8eff1; border-radius:24rpx; font-size:32rpx; color:#161d1f; box-sizing:border-box }
.add-btn2{ display:flex; align-items:center; justify-content:center; gap:6rpx; background:#006d37; color:#fff; padding:0 36rpx; height:88rpx; border-radius:24rpx; font-size:30rpx; font-weight:500; flex-shrink:0; white-space:nowrap }
.add-btn2:active{ transform:scale(.95) }
.add-ico{ font-size:36rpx; font-weight:300 }

/* 弹窗 */
.modal{ position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(22,29,31,.4); z-index:200; display:flex; align-items:center; justify-content:center; padding:32rpx 24rpx }
.modal-box{ background:#fff; border-radius:56rpx; box-shadow:0 48rpx 96rpx rgba(0,0,0,.12); width:100%; box-sizing:border-box }

/* 消课 */
.modal-class{ max-width:600rpx }
.mc-body{ padding:64rpx 64rpx 0; text-align:center; display:flex; flex-direction:column; align-items:center }
.mc-circle{ width:128rpx; height:128rpx; border-radius:50%; background:rgba(46,204,113,.1); display:flex; align-items:center; justify-content:center; margin-bottom:48rpx }
.mc-check{ font-size:64rpx; color:#006d37; font-weight:700 }
.mc-title{ font-size:48rpx; font-weight:600; color:#161d1f; margin-bottom:16rpx }
.mc-desc{ font-size:32rpx; color:#5c5f60; line-height:1.5 }
.mc-btns{ display:flex; gap:24rpx; padding:48rpx }
.mc-btn{ flex:1; height:88rpx; border-radius:88rpx; display:flex; align-items:center; justify-content:center; font-size:34rpx; font-weight:500 }
.mc-btn:active{ transform:scale(.98); opacity:.8 }
.mc-cancel{ border:2rpx solid #bbcbbb; color:#5c5f60 }
.mc-ok{ background:#006d37; color:#fff; box-shadow:0 16rpx 48rpx rgba(0,109,55,.16) }

/* 表单 */
.modal-form{ max-width:640rpx; width:100%; max-height:85vh; display:flex; flex-direction:column; box-sizing:border-box; overflow:hidden }
.mf-head{ display:flex; align-items:center; justify-content:center; min-height:88rpx; border-bottom:2rpx solid rgba(221,228,230,.3); flex-shrink:0 }
.mf-title{ font-size:40rpx; font-weight:600; color:#161d1f; line-height:88rpx }
.mf-body{ flex:1; padding:24rpx 32rpx; overflow-x:hidden; min-height:500rpx; box-sizing:border-box }
.mf-av{ width:140rpx; height:140rpx; border-radius:50%; margin:0 auto 24rpx; background:rgba(46,204,113,.1); display:flex; align-items:center; justify-content:center; position:relative; border:6rpx solid rgba(0,109,55,.05); flex-shrink:0 }
.mf-av:active{ transform:scale(.95) }
.mf-av-emoji{ font-size:84rpx; line-height:1 }
.mf-av-hint{ position:absolute; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,.05); border-radius:50%; display:flex; align-items:center; justify-content:center; opacity:0 }
.mf-av:active .mf-av-hint{ opacity:1 }
.mf-f{ margin-bottom:28rpx; width:100% }
.mf-lbl{ display:block; font-size:24rpx; font-weight:600; color:#5c5f60; padding:0 4rpx; margin-bottom:6rpx }
.mf-inp{ width:100%; height:88rpx; background:#e8eff1; border-bottom:4rpx solid #bbcbbb; border-radius:16rpx 16rpx 0 0; padding:0 24rpx; font-size:32rpx; color:#161d1f; box-sizing:border-box; margin:0 }
.mf-num{ font-family:'Lexend',sans-serif }
.mf-date{ display:flex; align-items:center }
.mf-ph{ color:#9ca3af }
.mf-ta{ width:100%; min-height:110rpx; background:#e8eff1; border-bottom:4rpx solid #bbcbbb; border-radius:16rpx 16rpx 0 0; padding:20rpx 24rpx; font-size:32rpx; color:#161d1f; box-sizing:border-box; margin:0; overflow-x:hidden }
.mf-quick{ display:flex; gap:12rpx; margin-bottom:24rpx; width:100% }
.mq-btn{ flex:1; height:64rpx; display:flex; align-items:center; justify-content:center; border-radius:24rpx; border:2rpx solid #bbcbbb; font-size:28rpx; color:#3d4a3e }
.mq-btn:active{ transform:scale(.95) }
.mq-on{ border:4rpx solid #006d37; background:rgba(46,204,113,.1); color:#006d37 }
.mf-spacer{ height:20rpx }
.mf-foot{ display:flex; gap:28rpx; padding:24rpx 40rpx 40rpx; flex-shrink:0 }
.mff-btn{ height:88rpx; display:flex; align-items:center; justify-content:center; font-size:34rpx; font-weight:500 }
.mff-btn:active{ transform:scale(.95) }
.mff-cancel{ flex:1; border:2rpx solid #bbcbbb; color:#5c5f60; border-radius:88rpx }
.mff-ok{ flex:1; background:#006d37; color:#fff; border-radius:88rpx; box-shadow:0 16rpx 48rpx rgba(0,109,55,.16) }

/* 删除 */
.modal-del{ max-width:560rpx; padding:56rpx 40rpx 40rpx; display:flex; flex-direction:column; align-items:center }
.md-icon{ width:88rpx; height:88rpx; border-radius:50%; background:#ffdad6; display:flex; align-items:center; justify-content:center; margin-bottom:40rpx; font-size:44rpx }
.md-title{ font-size:44rpx; font-weight:600; color:#161d1f; margin-bottom:28rpx; text-align:center }
.md-desc{ font-size:32rpx; color:#3d4a3e; text-align:center; margin-bottom:56rpx; line-height:1.5 }
.md-btns{ display:flex; gap:20rpx; width:100% }
.md-btn{ flex:1; height:88rpx; border-radius:88rpx; display:flex; align-items:center; justify-content:center; font-size:34rpx; font-weight:500 }
.md-btn:active{ opacity:.8 }
.md-cancel{ border:2rpx solid #6c7b6d; color:#161d1f }
.md-ok{ background:#b4271d; color:#fff }

/* 课时过期 */
.modal-exp{ max-width:560rpx; padding:56rpx 0 0; display:flex; flex-direction:column; align-items:center }
.me-outer{ width:120rpx; height:120rpx; border-radius:50%; background:#fef9c3; display:flex; align-items:center; justify-content:center; margin-bottom:40rpx }
.me-inner{ width:88rpx; height:88rpx; border-radius:50%; background:#fef08a; display:flex; align-items:center; justify-content:center; border:4rpx solid #fff }
.me-mark{ font-size:52rpx; color:#ca8a04; font-weight:700 }
.me-title{ font-size:40rpx; font-weight:600; color:#161d1f; margin-bottom:12rpx }
.me-desc{ font-size:28rpx; color:#5c5f60; margin-bottom:56rpx }
.me-btn-wrap{ width:100%; padding:0 36rpx 36rpx; display:flex; justify-content:center }
.me-btn{ width:auto; height:88rpx; border-radius:88rpx; padding:0 120rpx; background:#006d37; display:flex; align-items:center; justify-content:center; color:#fff; font-size:34rpx; font-weight:500; box-shadow:0 16rpx 48rpx rgba(0,109,55,.16) }
.me-btn:active{ transform:scale(.95) }

/* 升级 */
.modal-upg{ max-width:600rpx }
.mu-head{ background:linear-gradient(135deg,#006d37,#2ecc71); padding:56rpx 56rpx 40rpx; display:flex; flex-direction:column; align-items:center; position:relative }
.mu-badge{ position:absolute; top:24rpx; right:24rpx; background:rgba(255,255,255,.2); border:2rpx solid rgba(255,255,255,.3); border-radius:96rpx; padding:6rpx 20rpx }
.mu-badge text{ font-size:22rpx; font-weight:600; color:#fff }
.mu-crown{ width:120rpx; height:120rpx; border-radius:50%; background:rgba(255,255,255,.2); display:flex; align-items:center; justify-content:center; margin-bottom:24rpx; font-size:72rpx }
.mu-htitle{ font-size:48rpx; font-weight:700; color:#fff }
.mu-body{ padding:40rpx }
.mu-desc{ font-size:32rpx; color:#5c5f60; line-height:1.7; text-align:center; display:block; margin-bottom:40rpx }
.plan{ display:flex; align-items:center; gap:28rpx; padding:28rpx; border-radius:24rpx; border:4rpx solid #bbcbbb; margin-bottom:20rpx }
.plan-on{ border-color:#006d37; background:rgba(46,204,113,.1) }
.plan-rd{ width:36rpx; height:36rpx; border-radius:50%; border:4rpx solid #bbcbbb; display:flex; align-items:center; justify-content:center; flex-shrink:0 }
.rd-on{ border-color:#006d37 }
.rd-dot{ width:20rpx; height:20rpx; border-radius:50%; background:#006d37 }
.plan-info{ flex:1 }
.plan-n{ display:block; font-size:34rpx; font-weight:500; color:#161d1f; margin-bottom:4rpx }
.plan-s{ display:block; font-size:28rpx }
.mu-submit{ width:100%; height:100rpx; border-radius:100rpx; background:linear-gradient(135deg,#006d37,#2ecc71); display:flex; align-items:center; justify-content:center; color:#fff; font-size:38rpx; font-weight:600; box-shadow:0 16rpx 48rpx rgba(0,109,55,.2); margin-top:28rpx }
.mu-submit:active{ transform:scale(.95) }
.mu-later{ text-align:center; padding:28rpx 0 0; font-size:32rpx; color:#5c5f60 }

/* 历史记录弹窗 */
.modal-hist{ max-width:640rpx; max-height:82vh; display:flex; flex-direction:column; overflow:hidden }
.mh-head{ display:flex; align-items:center; justify-content:center; height:88rpx; flex-shrink:0 }
.mh-title{ font-size:40rpx; font-weight:600; color:#161d1f }
.mh-sum{ display:flex; align-items:center; gap:24rpx; margin:12rpx 32rpx 16rpx; padding:28rpx; background:#eef5f7; border-radius:28rpx; flex-shrink:0 }
.mhs-av{ width:96rpx; height:96rpx; border-radius:50%; background:rgba(46,204,113,.2); display:flex; align-items:center; justify-content:center; border:4rpx solid #e8eff1; flex-shrink:0 }
.mhs-emoji{ font-size:56rpx }
.mhs-info{ flex:1 }
.mhs-name{ display:block; font-size:36rpx; font-weight:600; color:#161d1f; margin-bottom:6rpx }
.mhs-badge{ display:inline-flex; background:rgba(46,204,113,.15); padding:5rpx 18rpx; border-radius:96rpx }
.mhs-badge text{ font-size:24rpx; font-weight:600; color:#006d37 }
.mh-body{ flex:1; padding:0 28rpx; min-height:200rpx; max-height:600rpx }
.mhb-lbl{ display:block; font-size:32rpx; font-weight:600; color:#5c5f60; padding-bottom:16rpx }
.hrec{ background:#fff; border-radius:20rpx; border:2rpx solid rgba(221,228,230,.3); padding:18rpx; margin-bottom:16rpx; box-sizing:border-box; overflow:hidden }
.hrec-g{ border-left:6rpx solid #2ecc71 }
.hrec-l{ display:flex; align-items:center; gap:16rpx }
.hrec-ico{ width:56rpx; height:56rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:32rpx }
.hri-red{ background:rgba(186,26,26,.1); color:#ba1a1a }
.hri-yel{ background:#fef9c3; color:#ca8a04 }
.hri-gr{ background:rgba(46,204,113,.2); color:#006d37 }
.hrec-info{ flex:1; min-width:0; overflow:hidden }
.hrec-act{ display:block; font-size:32rpx; color:#161d1f }
.hrec-num{ font-weight:600 }
.hrec-time{ display:block; font-size:26rpx; color:#5c5f60; margin-top:4rpx }
.hrec-empty{ text-align:center; padding:100rpx 0; color:#5c5f60 }
.mh-foot{ padding:20rpx 32rpx; padding-bottom:calc(20rpx + env(safe-area-inset-bottom)); flex-shrink:0 }
.mhf-btn{ width:100%; height:84rpx; border-radius:84rpx; background:#006d37; display:flex; align-items:center; justify-content:center; color:#fff; font-size:32rpx; font-weight:500 }

/* Toast */
.toast{ position:fixed; left:50%; transform:translateX(-50%); z-index:150; background:#2b3234; color:#f4fafd; border-radius:96rpx; padding:22rpx 40rpx; display:flex; align-items:center; gap:16rpx; box-shadow:0 20rpx 50rpx -10rpx rgba(0,0,0,.1); opacity:0; pointer-events:none; transition:opacity .3s }
.toast-on{ opacity:1; pointer-events:auto }
.toast-undo{ bottom:210rpx; justify-content:center; gap:24rpx; flex-wrap:nowrap }
.toast-top{ top:220rpx }
.toast-bot{ bottom:210rpx; justify-content:center }
.toast-left{ display:flex; align-items:center; gap:12rpx; white-space:nowrap; flex-shrink:0 }
.toast-gr{ color:#6bfe9c; font-size:30rpx; font-weight:700 }
.toast-wt{ color:#f4fafd; font-size:30rpx; font-weight:500; white-space:nowrap }
.toast-div{ width:2rpx; height:28rpx; background:#dde4e6; flex-shrink:0 }
.toast-link{ color:#6bfe9c; font-size:34rpx; font-weight:500; white-space:nowrap }
.toast-link:active{ opacity:.7 }