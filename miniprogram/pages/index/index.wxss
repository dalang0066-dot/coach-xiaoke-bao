.card-face{ position:relative; z-index:2; background:linear-gradient(180deg,#fff 0%,#fff 62%,#fbfdfe 100%); transition:transform .25s ease,opacity .25s ease; overflow:hidden; min-height:184rpx; border:1rpx solid rgba(178,194,201,.55); border-radius:20rpx; box-sizing:border-box; box-shadow:inset 0 1rpx 0 rgba(255,255,255,.95) }
.card-face:active{ transform:translateY(2rpx) scale(.996); opacity:.98 }
.card-face::before{ content:''; position:absolute; left:0; top:0; bottom:0; width:8rpx; background:#d8e0e3; border-radius:20rpx 0 0 20rpx; z-index:1 }
.card-face::after{ content:''; position:absolute; left:10rpx; right:10rpx; top:1rpx; height:2rpx; border-radius:2rpx; background:rgba(255,255,255,.9); z-index:1 }
.card-main{ position:relative; z-index:2; display:flex; align-items:center; padding:22rpx 22rpx 10rpx 22rpx; background:transparent }
.card-swiped{ transform:translateX(-354rpx) }
.card-hl-green{ box-shadow:0 2rpx 6rpx rgba(15,35,42,.04),0 14rpx 34rpx rgba(15,35,42,.09) }
.card-hl-red{ box-shadow:0 2rpx 6rpx rgba(15,35,42,.04),0 14rpx 34rpx rgba(15,35,42,.09) }
.card-schedule-green{ box-shadow:inset 0 0 0 1rpx rgba(0,137,70,.05) }
.card-schedule-green::before{ background:#008946; box-shadow:0 0 18rpx rgba(0,137,70,.34) }
.card-schedule-red{ background:linear-gradient(90deg,#fff0ee 0%,#fff7f6 44%,#fff 100%); box-shadow:inset 0 0 0 1rpx rgba(216,25,32,.04) }
.card-schedule-red::before{ background:#d81920 }
.card-schedule-gray::before{ background:transparent }
.card-low-line.card-face::before{ background:#d81920; box-shadow:0 0 18rpx rgba(216,25,32,.24) }
.card-gray.card-face{ background:#edf2f4 }
.card-gray.card-face::before{ background:#9aa6ac }
.card-red.card-face{ background:linear-gradient(90deg,#fff0ee 0%,#fff7f6 44%,#fff 100%); box-shadow:inset 0 0 0 1rpx rgba(216,25,32,.04) }
.card-red.card-face::before{ background:#d81920; box-shadow:0 0 18rpx rgba(216,25,32,.24) }
.card-face.card-hint{ animation: swipeHint 1.5s ease-in-out }
.card-hint-tip{ text-align:center; padding:20rpx 0 8rpx }
.card-hint-tip text{ font-size:30rpx; color:#008946; background:rgba(0,137,70,.12); padding:14rpx 36rpx; border-radius:48rpx }
@keyframes swipeHint {
  0%{ left:0 }
  25%{ left:-70rpx }
  50%{ left:0 }
  75%{ left:-70rpx }
  100%{ left:0 }
}

